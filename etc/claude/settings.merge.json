{
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "remoteControlAtStartup": false,
  "statusLine": {
    "type": "command",
    "command": "python3 @HOME@/.claude/hooks/usage_statusline.py",
    "refreshInterval": 60
  },
  "permissions": {
    "defaultMode": "bypassPermissions"
  },
  "autoMode": {
    "allow": [
      "$defaults",
      "Cbox Codex Delegation: Calling the cbox codex MCP delegates (mcp__codex-astra, mcp__codex-sol, mcp__codex-luna) with approval-policy=never and sandbox=danger-full-access is NOT Create Unsafe Agents when Claude Code runs inside the cbox container. The container is the security boundary, not the codex sandbox: bubblewrap cannot create namespaces inside it, so read-only and workspace-write both fail the moment codex runs any shell command, and on-request would make codex elicit a human Accept/Decline answer that an unattended run hangs on forever. Every such call is independently gated by the codex_mode_guard.py PreToolUse hook on an in-scope git-worktree cwd, a one-hop delegation depth limit, and a bytewise audit log. This exception is scoped to those three MCP tools inside the container and clears nothing else."
    ]
  },
  "env": {
    "DISABLE_ERROR_REPORTING": "1",
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "claude-opus-5-5[1m]",
    "ANTHROPIC_DEFAULT_FABLE_MODEL": "claude-fable-5[1m]",
    "CBOX_AGENT_MODEL_DENY": "opus-4",
    "CBOX_AGENT_MODEL_BAN": "fable-5-1",
    "IS_SANDBOX": "1"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 @HOME@/.claude/hooks/continuity_session_start.py --section core",
            "timeout": 10,
            "statusMessage": "continuity session start (core)"
          },
          {
            "type": "command",
            "command": "python3 @HOME@/.claude/hooks/continuity_session_start.py --section memory",
            "timeout": 10,
            "statusMessage": "continuity session start (memory)"
          },
          {
            "type": "command",
            "command": "python3 @HOME@/.claude/hooks/continuity_session_start.py --section ledger",
            "timeout": 10,
            "statusMessage": "continuity session start (ledger)"
          },
          {
            "type": "command",
            "command": "python3 @HOME@/.claude/hooks/continuity_session_start.py --section progress",
            "timeout": 10,
            "statusMessage": "continuity session start (progress)"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "mcp__codex-.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 @HOME@/.claude/hooks/codex_mode_guard.py",
            "timeout": 10,
            "statusMessage": "codex-mode guard"
          }
        ]
      },
      {
        "matcher": "Agent|Workflow",
        "hooks": [
          {
            "type": "command",
            "command": "python3 @HOME@/.claude/hooks/agent_label_guard.py",
            "timeout": 10,
            "statusMessage": "agent-label guard"
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 @HOME@/.claude/hooks/code_hygiene_guard.py",
            "timeout": 10,
            "statusMessage": "code-hygiene guard"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 @HOME@/.claude/hooks/commit_guard.py",
            "timeout": 10,
            "statusMessage": "commit guard"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 @HOME@/.claude/hooks/rm_glob_guard.py",
            "timeout": 10,
            "statusMessage": "rm-glob guard"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 @HOME@/.claude/hooks/net_proxy_guard.py",
            "timeout": 10,
            "statusMessage": "net-proxy guard"
          }
        ]
      },
      {
        "matcher": "Agent|Workflow",
        "hooks": [
          {
            "type": "command",
            "command": "python3 @HOME@/.claude/hooks/spawn_gate.py",
            "timeout": 15,
            "statusMessage": "spawn gate"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 @HOME@/.claude/hooks/rm_permission_gate.py",
            "timeout": 10,
            "statusMessage": "rm permission gate"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 @HOME@/.claude/hooks/continuity_commit_log.py",
            "timeout": 10,
            "statusMessage": "continuity commit log"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 @HOME@/.claude/hooks/continuity_ledger_sweep.py",
            "timeout": 10,
            "statusMessage": "continuity ledger sweep"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 @HOME@/.claude/hooks/continuity_session_digest.py",
            "timeout": 10,
            "statusMessage": "continuity session digest"
          }
        ]
      }
    ]
  }
}
