{
  "codex-terra-light": {
    "type": "stdio",
    "command": "codex",
    "args": [
      "mcp-server"
    ],
    "_cbox": {
      "adapter": "codex-mcp",
      "available_to": [
        "claude",
        "hermes"
      ],
      "backend": "codex",
      "side_effects": [
        "spawns-codex-subprocess"
      ],
      "model": "gpt-5.6-terra",
      "model_reasoning_effort": "medium"
    }
  },
  "codex-sol": {
    "type": "stdio",
    "command": "codex",
    "args": [
      "mcp-server"
    ],
    "_cbox": {
      "adapter": "codex-mcp",
      "available_to": [
        "claude",
        "hermes"
      ],
      "backend": "codex",
      "side_effects": [
        "spawns-codex-subprocess"
      ],
      "model": "gpt-5.6-sol",
      "model_reasoning_effort": "xhigh"
    }
  },
  "codex-astra": {
    "type": "stdio",
    "command": "codex",
    "args": [
      "mcp-server"
    ],
    "_cbox": {
      "adapter": "codex-mcp",
      "available_to": [
        "claude",
        "hermes"
      ],
      "backend": "codex",
      "side_effects": [
        "spawns-codex-subprocess"
      ],
      "model": "gpt-6-astra",
      "model_reasoning_effort": "xhigh"
    }
  },
  "codex-terra": {
    "type": "stdio",
    "command": "codex",
    "args": [
      "mcp-server"
    ],
    "_cbox": {
      "adapter": "codex-mcp",
      "available_to": [
        "claude",
        "hermes"
      ],
      "backend": "codex",
      "side_effects": [
        "spawns-codex-subprocess"
      ],
      "model": "gpt-5.6-terra",
      "model_reasoning_effort": "max"
    }
  },
  "codex-luna": {
    "type": "stdio",
    "command": "codex",
    "args": [
      "mcp-server"
    ],
    "_cbox": {
      "adapter": "codex-mcp",
      "available_to": [
        "claude",
        "hermes"
      ],
      "backend": "codex",
      "side_effects": [
        "spawns-codex-subprocess"
      ],
      "model": "gpt-5.6-luna",
      "model_reasoning_effort": "max"
    }
  },
  "ask-claude": {
    "_cbox": {
      "adapter": "claude-cli",
      "available_to": [
        "codex",
        "hermes"
      ],
      "backend": "claude",
      "side_effects": [
        "spawns-claude-subprocess"
      ],
      "command": "python3",
      "script": "ask_claude_mcp.py",
      "startup_timeout_sec": 30,
      "tool_timeout_sec": 3600
    }
  },
  "local-qwen": {
    "type": "stdio",
    "command": "python3",
    "args": [
      "local_model_mcp.py"
    ],
    "env": {
      "CBOX_LOCAL_MODEL_URL": "@CBOX_LOCAL_MODEL_URL@",
      "CBOX_LOCAL_MODEL_NAME": "@CBOX_LOCAL_MODEL_NAME@",
      "CBOX_LOCAL_MODEL_TIMEOUT_SEC": "@CBOX_LOCAL_MODEL_TIMEOUT_SEC@"
    },
    "startup_timeout_sec": 30,
    "tool_timeout_sec": 3600,
    "_cbox": {
      "adapter": "stdio-mcp",
      "available_to": [
        "claude",
        "codex",
        "hermes"
      ],
      "backend": "ollama",
      "side_effects": [
        "text-only"
      ],
      "enabled_when_env": [
        "CBOX_LOCAL_MODEL",
        "CBOX_LOCAL_MODEL_URL",
        "CBOX_LOCAL_MODEL_NAME"
      ],
      "tool_timeout_from_env": {
        "var": "CBOX_LOCAL_MODEL_TIMEOUT_SEC",
        "default": 600,
        "headroom_sec": 60
      }
    }
  },
  "container-exec": {
    "type": "stdio",
    "command": "python3",
    "args": [
      "container_exec_mcp.py"
    ],
    "startup_timeout_sec": 30,
    "tool_timeout_sec": 3600,
    "_cbox": {
      "adapter": "stdio-mcp",
      "available_to": [
        "claude",
        "codex",
        "hermes"
      ],
      "backend": "docker-exec-bridge",
      "side_effects": [
        "spawns-docker-exec-subprocess"
      ],
      "enabled_when_env": "CBOX_CONTAINER_EXEC_TOOL"
    }
  },
  "hermes-local": {
    "type": "stdio",
    "command": "python3",
    "args": [
      "hermes_delegate_mcp.py"
    ],
    "env": {
      "HERMES_BIN": "@CBOX_HERMES_DELEGATE_BIN@",
      "CBOX_HERMES_DELEGATE_HOME_TEMPLATE": "@CBOX_HERMES_DELEGATE_HOME_TEMPLATE@",
      "CBOX_HERMES_DELEGATE_PROVIDER": "@CBOX_HERMES_DELEGATE_PROVIDER@",
      "CBOX_HERMES_DELEGATE_BASE_URL": "@CBOX_HERMES_DELEGATE_BASE_URL@",
      "CBOX_HERMES_DELEGATE_MODEL": "@CBOX_HERMES_DELEGATE_MODEL@",
      "CBOX_HERMES_DELEGATE_MODE": "@CBOX_HERMES_DELEGATE_MODE@",
      "CBOX_HERMES_DELEGATE_DISABLED_TOOLSETS": "@CBOX_HERMES_DELEGATE_DISABLED_TOOLSETS@",
      "CBOX_HERMES_PROVIDER": "@CBOX_HERMES_PROVIDER@",
      "CBOX_HERMES_MODEL_URL": "@CBOX_HERMES_MODEL_URL@",
      "CBOX_HERMES_MODEL_NAME": "@CBOX_HERMES_MODEL_NAME@",
      "CBOX_HERMES_DELEGATE_MAX_CONCURRENCY": "@CBOX_HERMES_DELEGATE_MAX_CONCURRENCY@",
      "CBOX_HERMES_DELEGATE_QUEUE_WAIT_SEC": "@CBOX_HERMES_DELEGATE_QUEUE_WAIT_SEC@",
      "CBOX_HERMES_DELEGATE_LOCK_DIR": "@CBOX_HERMES_DELEGATE_LOCK_DIR@",
      "OLLAMA_NUM_PARALLEL": "@OLLAMA_NUM_PARALLEL@",
      "CBOX_OLLAMA_CONTEXT_LENGTH": "@CBOX_OLLAMA_CONTEXT_LENGTH@",
      "CBOX_DELEGATION_DEPTH": "@CBOX_DELEGATION_DEPTH_FOR_CODEX_CHILD@",
      "CBOX_MCP_DEPTH": "@CBOX_DELEGATION_DEPTH_FOR_CODEX_CHILD@",
      "CBOX_HERMES_EFFORT": "@CBOX_HERMES_EFFORT@",
      "CBOX_LOCAL_MODEL_URL": "@CBOX_LOCAL_MODEL_URL@",
      "CBOX_LOCAL_MODEL_NAME": "@CBOX_LOCAL_MODEL_NAME@"
    },
    "startup_timeout_sec": 30,
    "tool_timeout_sec": 3600,
    "_cbox": {
      "adapter": "stdio-mcp",
      "available_to": [
        "claude",
        "codex",
        "hermes"
      ],
      "backend": "hermes",
      "side_effects": [
        "spawns-hermes-subprocess"
      ],
      "enabled_when_env": "CBOX_HERMES_DELEGATE"
    }
  }
}
