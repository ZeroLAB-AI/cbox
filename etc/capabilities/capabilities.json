        "codex": {"mechanism": "shim-developer-instructions-injection", "artifact": "etc/mcp/codex_mcp_shim.py", "status": "live"},
        "hermes": {"mechanism": "hermes-delegate-ignore-rules", "status": "declined"}
      },
      "degrade_floor": "none"
    },
