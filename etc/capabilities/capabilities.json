      "enabled_when_env": null,
      "planes": ["native", "substrate"],
      "bindings": {
        "claude": {"mechanism": "claude-md-block+sessionstart-loader", "artifact": "generated/claude-config/CLAUDE.md", "status": "live"},
        "codex": {"mechanism": "agents-override+sessionstart-loader", "artifact": "generated/codex/AGENTS.override.md", "status": "live"},
        "hermes": {"mechanism": "ephemeral-system-prompt", "status": "live"}
      },
      "degrade_floor": "none"
    },
