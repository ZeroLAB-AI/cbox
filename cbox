#!/usr/bin/env bash
set -euo pipefail

_CBOX_PREFLIGHT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [ -f "$_CBOX_PREFLIGHT_DIR/lib/portable_preflight.sh" ]; then
  . "$_CBOX_PREFLIGHT_DIR/lib/portable_preflight.sh"
  cbox_preflight_check bash || exit 1
fi
unset _CBOX_PREFLIGHT_DIR

INSTALL_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SERVICE=cbox
CONF="$INSTALL_DIR/cbox.conf"

[ -f "$INSTALL_DIR/_common.sh" ] && . "$INSTALL_DIR/_common.sh"
[ -f "$INSTALL_DIR/templates/generators.sh" ] && . "$INSTALL_DIR/templates/generators.sh"
[ -f "$INSTALL_DIR/templates/conf_lib.sh" ] && . "$INSTALL_DIR/templates/conf_lib.sh"
[ -f "$INSTALL_DIR/templates/validator_lib.sh" ] && . "$INSTALL_DIR/templates/validator_lib.sh"
[ -f "$INSTALL_DIR/templates/validator_dispatch.sh" ] && . "$INSTALL_DIR/templates/validator_dispatch.sh"
[ -f "$INSTALL_DIR/lib/cbox-ai.sh" ] && . "$INSTALL_DIR/lib/cbox-ai.sh"
[ -f "$INSTALL_DIR/lib/cbox-session.sh" ] && . "$INSTALL_DIR/lib/cbox-session.sh"

HAVE_GLOBAL_CONF=0
if [ -f "$CONF" ]; then
  source "$CONF"
  _cbox_reg_export_vars
  HAVE_GLOBAL_CONF=1
fi

_cbox_compose_refresh_gpu() {
  COMPOSE=(docker compose -f "$INSTALL_DIR/docker-compose.yml")
  if [ "${CBOX_GPU:-0}" = "1" ] && [ -f "$INSTALL_DIR/docker-compose.gpu.yml" ]; then
    COMPOSE+=(-f "$INSTALL_DIR/docker-compose.gpu.yml")
  fi
}

_cbox_compose_refresh_gpu

_cbox_offer_setup() {
  local msg="$1"
  if [ -t 0 ] && [ -t 1 ]; then
    printf '%scbox: %s\n  [y] run '\''cbox setup'\'' now   [n] cancel\n> ' "" "$msg" >&2
    local ans
    read -r ans
    case "$ans" in
      y|Y) exec "$INSTALL_DIR/cbox" setup ;;
      *) echo "cbox: cancelled" >&2; exit 1 ;;
    esac
  fi
  echo "cbox: $msg - run 'cbox setup' on the host" >&2
  exit 1
}

require_global_conf() {
  [ "$HAVE_GLOBAL_CONF" = 1 ] || _cbox_offer_setup "no cbox configuration yet"
}

die_no_conf() {
  _cbox_offer_setup "no configuration applies to $PWD"
}

check_tpl_sha() {
  require_global_conf
  local cur
  cur="$(_cbox_tpl_sha)"
  if [ "$cur" != "${CBOX_TPL_SHA:-}" ]; then
    echo "cbox: templates changed since last generation - run 'cbox setup update' to re-bless"
    exit 1
  fi
}

_cbox_local_effdir_for() {
  local root="$1" p
  p="$(_cbox_path_hash "$root")"
  printf '%s/.config/cbox/projects/%s' "$HOME" "$p"
}

_cbox_machine_scoped_vars() {
  _cbox_config_load_sections
  local s v
  for s in "${SECTIONS[@]}"; do
    [ "$(sec_get SEC_SCOPE "$s")" = machine ] || continue
    for v in $(sec_get SEC_VARS "$s"); do
      printf '%s\n' "$v"
    done
  done
}

_cbox_load_machine_scoped_vars() {
  local conf="$INSTALL_DIR/cbox.conf" v
  [ -f "$conf" ] || return 0
  while IFS= read -r v; do
    [ -n "$v" ] || continue
    printf -v "$v" '%s' "$(unset "$v"; . "$conf" >/dev/null 2>&1; printf '%s' "${!v-}")"
    export "$v"
  done < <(_cbox_machine_scoped_vars)
}

_cbox_root_in_global_scope() {
  local root="$1" w
  local -a ws=()
  read -r -a ws <<< "${CBOX_WORKSPACES:-}"
  for w in "${ws[@]}"; do
    [ -n "$w" ] || continue
    case "$root" in
      "$w"|"$w"/*) return 0 ;;
    esac
  done
  return 1
}

_cbox_effective_mode() {
  local root eff have_eff=0
  if root="$(_cbox_workspace_root 2>/dev/null)"; then
    eff="$(_cbox_local_effdir_for "$root")"
    [ -f "$eff/cbox.conf" ] && have_eff=1
  fi
  if [ "$HAVE_GLOBAL_CONF" = 1 ] && [ "${CBOX_MODE:-global}" = global ]; then
    if [ "$have_eff" = 1 ] && ! _cbox_root_in_global_scope "$root"; then
      printf 'isolated'
      return 0
    fi
    printf 'global'
    return 0
  fi
  if [ "$have_eff" = 1 ]; then
    printf 'isolated'
    return 0
  fi
  if [ "$HAVE_GLOBAL_CONF" = 1 ]; then
    printf '%s' "${CBOX_MODE:-global}"
    return 0
  fi
  printf 'none'
}

_compose_p() {
  local eff="$1"; shift
  docker compose --project-directory "$eff" -f "$eff/docker-compose.yml" "$@"
}

_cbox_compose_files_digest() {
  local expect_f=0 arg out=""
  for arg in "$@"; do
    if [ "$expect_f" = 1 ]; then
      expect_f=0
      [ -f "$arg" ] || continue
      out="$out$(_cbox_sha256 "$arg")"
      continue
    fi
    case "$arg" in
      -f|--file) expect_f=1 ;;
    esac
  done
  printf '%s' "$out" | _cbox_sha256
}

_cbox_compose_up() {
  local stamp="$1"; shift
  local new old="" force=0 rc=0 have=""
  new="$(_cbox_compose_files_digest "$@")"
  [ -n "$stamp" ] && [ -f "$stamp" ] && old="$(cat "$stamp" 2>/dev/null || true)"
  have="$("$@" ps -q cbox 2>/dev/null | head -n1)" || have=""
  if [ "${CBOX_MANAGED_SETTINGS_REPAIRED:-0}" = 1 ]; then
    force=1
  fi
  if [ -n "$have" ] && [ "$old" != "$new" ]; then
    force=1
  fi
  if [ "$force" = 1 ]; then
    "$@" up -d --force-recreate || rc=$?
  else
    "$@" up -d || rc=$?
  fi
  if [ "$rc" -eq 0 ] && [ -n "$stamp" ]; then
    printf '%s\n' "$new" > "$stamp" 2>/dev/null || true
  fi
  return "$rc"
}

_cbox_netaccess_render() {
  local container_id="$1" state_dir="$2" scope network cidr result internal_ip internal_cidr targets skipped_line
  local -a args=()
  CBOX_NETACCESS_SKIPPED=""
  _cbox_proxy_active || return 0
  [ -n "$container_id" ] || { echo "cbox: netaccess proxy container is not running" >&2; return 1; }
  if _cbox_netaccess_active; then
    scope="$(_cbox_netaccess_scope)"
    for network in ${CBOX_NETACCESS_NETWORKS:-}; do
      args+=(--network "$network")
    done
    for cidr in ${CBOX_NETACCESS_CIDRS:-}; do
      args+=(--cidr "$cidr")
    done
  else
    scope=list
  fi
  result="$(python3 "$INSTALL_DIR/lib/cbox_netaccess.py" \
    --container "$container_id" \
    --state-dir "$state_dir" \
    --scope "$scope" \
    "${args[@]}")" || return 1
  internal_ip="$(python3 -c 'import json,sys; print(json.load(sys.stdin)["internalIp"])' <<<"$result")" || return 1
  internal_cidr="$(python3 -c 'import json,sys; print(json.load(sys.stdin)["internalCidr"])' <<<"$result")" || return 1
  targets="$(python3 -c 'import json,sys; d=json.load(sys.stdin); print(" ".join(x["externalIp"]+","+x["cidr"] for x in d["targets"]))' <<<"$result")" || return 1
  CBOX_NETACCESS_SKIPPED="$(python3 -c 'import json,sys; d=json.load(sys.stdin); print("\n".join(x["network"]+"\t"+x["reason"] for x in d["skipped"] if x.get("requested")))' <<<"$result")" || return 1
  if [ -n "$CBOX_NETACCESS_SKIPPED" ]; then
    while IFS="$(printf '\t')" read -r network skipped_line; do
      [ -n "$network" ] || continue
      printf 'cbox: netaccess: SKIPPING granted network %s - %s; nothing on it is reachable until this clears\n' "$network" "$skipped_line" >&2
    done <<<"$CBOX_NETACCESS_SKIPPED"
  fi
  if _cbox_egress_active; then
    gen_tinyproxy_conf_into "$state_dir" "$internal_ip"
  fi
  if _cbox_netaccess_active; then
    gen_sockd_conf_into "$state_dir" "$internal_ip" "$internal_cidr" "$targets"
  fi
}

_cbox_netaccess_verify_listener() {
  local exec_prefix="$1" container_id port i
  _cbox_netaccess_active || return 0
  container_id="$($exec_prefix ps -q proxy 2>/dev/null | head -n1)" || container_id=""
  [ -n "$container_id" ] || return 1
  port="${CBOX_NETACCESS_SOCKS_PORT:-1080}"
  case "$port" in
    ''|*[!0-9]*) port=1080 ;;
    *) [ "${#port}" -le 5 ] && [ "$port" -ge 1 ] && [ "$port" -le 65535 ] || port=1080 ;;
  esac
  for i in 1 2 3 4 5; do
    if docker exec "$container_id" sh -c "nc -z -w 2 127.0.0.1 $port || nc -z -w 2 \"\$(cat /etc/cbox-generated/internal-ip 2>/dev/null)\" $port" >/dev/null 2>&1; then
      return 0
    fi
    sleep 0.5
  done
  return 1
}

_cbox_netaccess_socks_exec_env() {
  CBOX_SOCKS_EXEC_ENV=()
  _cbox_netaccess_active || return 0
  local port="${CBOX_NETACCESS_SOCKS_PORT:-1080}"
  case "$port" in
    ''|*[!0-9]*) port=1080 ;;
    *) [ "${#port}" -le 5 ] && [ "$port" -ge 1 ] && [ "$port" -le 65535 ] || port=1080 ;;
  esac
  CBOX_SOCKS_EXEC_ENV=(-e "CBOX_SOCKS_PROXY=socks5h://$(_cbox_proxy_internal_alias):$port")
}

_cbox_netaccess_apply_global() {
  _cbox_proxy_active || return 0
  local container_id
  container_id="$("${COMPOSE[@]}" ps -q proxy 2>/dev/null)" || container_id=""
  _cbox_netaccess_render "$container_id" "$INSTALL_DIR/generated/proxy" || return 1
  "${COMPOSE[@]}" restart proxy >/dev/null || {
    echo "cbox: proxy restart failed - the running proxy still serves the previous rules" >&2
    return 1
  }
  if ! _cbox_netaccess_active; then
    return 0
  fi
  _cbox_netaccess_verify_listener "${COMPOSE[*]}" || {
    echo "cbox: SOCKS listener is not answering on the proxy after restart - the new rules are NOT in force; check 'cbox logs proxy'" >&2
    return 1
  }
}

_cbox_netaccess_apply_isolated() {
  local eff="$1" container_id
  _cbox_proxy_active || return 0
  container_id="$(_compose_p "$eff" ps -q proxy 2>/dev/null)" || container_id=""
  _cbox_netaccess_render "$container_id" "$eff/proxy" || return 1
  _compose_p "$eff" restart proxy >/dev/null || {
    echo "cbox: proxy restart failed - the running proxy still serves the previous rules" >&2
    return 1
  }
  if ! _cbox_netaccess_active; then
    return 0
  fi
  _cbox_netaccess_verify_listener "_compose_p $eff" || {
    echo "cbox: SOCKS listener is not answering on the proxy after restart - the new rules are NOT in force; check 'cbox logs proxy'" >&2
    return 1
  }
}

_netaccess_valid_name() {
  printf '%s' "$1" | grep -Eq '^[A-Za-z0-9][A-Za-z0-9_.-]*$'
}

_netaccess_classify() {
  local target="$1"
  case "$target" in
    */*) printf 'cidr'; return 0 ;;
  esac
  _netaccess_valid_name "$target" || return 1
  if docker network inspect -- "$target" >/dev/null 2>&1; then
    printf 'network'
    return 0
  fi
  if docker inspect --type container -- "$target" >/dev/null 2>&1; then
    printf 'container'
    return 0
  fi
  return 1
}

_netaccess_container_networks() {
  docker inspect --type container --format '{{range $k, $v := .NetworkSettings.Networks}}{{$k}}{{"\n"}}{{end}}' -- "$1" 2>/dev/null \
    | sed '/^$/d'
}

_netaccess_set_add() {
  local cur="$1" item="$2" w
  for w in $cur; do
    [ "$w" = "$item" ] && { printf '%s' "$cur"; return 1; }
  done
  printf '%s' "${cur:+$cur }$item"
}

_netaccess_set_has() {
  local cur="$1" item="$2" w
  for w in $cur; do
    [ "$w" = "$item" ] && return 0
  done
  return 1
}

_netaccess_set_del() {
  local cur="$1" item="$2" w out=""
  for w in $cur; do
    [ "$w" = "$item" ] && continue
    out="${out:+$out }$w"
  done
  printf '%s' "$out"
}

_netaccess_state_dir() {
  case "$1" in
    global) printf '%s/generated/proxy' "$INSTALL_DIR" ;;
    *) printf '%s/proxy' "$1" ;;
  esac
}

_netaccess_print_status() {
  local mode="$1" eff="$2" state_dir proxy_id
  state_dir="$(_netaccess_state_dir "${eff:-global}")"
  echo "mode:      $mode"
  echo "netaccess: ${CBOX_NETACCESS_MODE:-off} (applied=${CBOX_NETACCESS_APPLIED:-0})"
  echo "scope:     $(_cbox_netaccess_scope)"
  echo "networks:  ${CBOX_NETACCESS_NETWORKS:-<none>}"
  echo "cidrs:     ${CBOX_NETACCESS_CIDRS:-<none>}"
  echo "exec mode: ${CBOX_NETACCESS_EXEC_MODE:-off} (workspace-guard=${CBOX_NETACCESS_EXEC_WORKSPACE_GUARD:-off})"
  if [ "$mode" = global ]; then
    proxy_id="$("${COMPOSE[@]}" ps -q proxy 2>/dev/null)" || proxy_id=""
  else
    proxy_id="$(_compose_p "$eff" ps -q proxy 2>/dev/null)" || proxy_id=""
  fi
  if [ -n "$proxy_id" ]; then
    echo "proxy:     running ($(printf '%.12s' "$proxy_id"))"
  else
    echo "proxy:     not running - allow/deny will write config only"
  fi
  if [ -f "$state_dir/applied-networks.json" ]; then
    echo "applied:   $(cat "$state_dir/applied-networks.json")"
  else
    echo "applied:   <no state yet>"
  fi
  echo
  echo "note: a pass rule covers the target network's WHOLE subnet on all TCP ports - allowing"
  echo "      one container allows every container on its networks."
}

_cbox_running_cbox_sees_netaccess() {
  local mode="$1" eff="$2" cbox_id
  if [ "$mode" = global ]; then
    cbox_id="$("${COMPOSE[@]}" ps -q "$SERVICE" 2>/dev/null | head -n1)" || cbox_id=""
  else
    cbox_id="$(_compose_p "$eff" ps -q cbox 2>/dev/null | head -n1)" || cbox_id=""
  fi
  [ -n "$cbox_id" ] || return 1
  docker inspect -f '{{range $n, $e := .NetworkSettings.Networks}}{{$n}} {{end}}' "$cbox_id" 2>/dev/null | grep -q 'internal' || return 1
  docker inspect -f '{{range .Config.Env}}{{println .}}{{end}}' "$cbox_id" 2>/dev/null | grep -q '^CBOX_SOCKS_PROXY=' || return 1
  return 0
}

_netaccess_apply_now() {
  local mode="$1" eff="$2" proxy_id
  if [ "$mode" = global ]; then
    proxy_id="$("${COMPOSE[@]}" ps -q proxy 2>/dev/null)" || proxy_id=""
  else
    proxy_id="$(_compose_p "$eff" ps -q proxy 2>/dev/null)" || proxy_id=""
  fi
  if [ -z "$proxy_id" ]; then
    echo "cbox: recorded in the config; the proxy is not running, so it takes effect on the next 'cbox run'"
    return 2
  fi
  if [ "$mode" = global ]; then
    _cbox_netaccess_apply_global
  else
    _cbox_netaccess_apply_isolated "$eff"
  fi
}

_netaccess_change() {
  local action="$1" mode="$2" eff="$3"; shift 3
  local target kind netvar cidrvar nets net changed=0 out
  netvar="${CBOX_NETACCESS_NETWORKS:-}"
  cidrvar="${CBOX_NETACCESS_CIDRS:-}"

  if [ "$(_cbox_netaccess_scope)" = all ]; then
    case "$action" in
      deny)
        echo "cbox: deny needs scope=list - under scope=all every eligible docker network is joined and the list is ignored" >&2
        echo "cbox: set it first: $0 config set CBOX_NETACCESS_SCOPE=list" >&2
        return 1
        ;;
      allow)
        echo "cbox: warning: scope=all already joins every eligible docker network; the entry is recorded but changes nothing until scope=list" >&2
        ;;
    esac
  fi

  for target in "$@"; do
    if [ "$action" = deny ]; then
      if _netaccess_set_has "$netvar" "$target"; then
        netvar="$(_netaccess_set_del "$netvar" "$target")"; changed=1; echo "cbox: - network $target"
        continue
      fi
      if _netaccess_set_has "$cidrvar" "$target"; then
        cidrvar="$(_netaccess_set_del "$cidrvar" "$target")"; changed=1; echo "cbox: - cidr $target"
        continue
      fi
    fi
    kind="$(_netaccess_classify "$target")" || {
      if [ "$action" = deny ]; then
        echo "cbox: $target is not in the allowed set and does not resolve to a docker network or container" >&2
      else
        echo "cbox: $target is neither a docker network, a running container, nor a CIDR" >&2
      fi
      return 1
    }
    case "$kind" in
      cidr)
        if [ "$action" = allow ]; then
          out="$(_netaccess_set_add "$cidrvar" "$target")" && { cidrvar="$out"; changed=1; echo "cbox: + cidr $target"; } \
            || echo "cbox: = cidr $target already allowed"
        else
          if _netaccess_set_has "$cidrvar" "$target"; then
            cidrvar="$(_netaccess_set_del "$cidrvar" "$target")"; changed=1; echo "cbox: - cidr $target"
          else
            echo "cbox: = cidr $target was not allowed"
          fi
        fi
        ;;
      network)
        if [ "$action" = allow ]; then
          out="$(_netaccess_set_add "$netvar" "$target")" && { netvar="$out"; changed=1; echo "cbox: + network $target"; } \
            || echo "cbox: = network $target already allowed"
        else
          if _netaccess_set_has "$netvar" "$target"; then
            netvar="$(_netaccess_set_del "$netvar" "$target")"; changed=1; echo "cbox: - network $target"
          else
            echo "cbox: = network $target was not allowed"
          fi
        fi
        ;;
      container)
        nets="$(_netaccess_container_networks "$target")"
        [ -n "$nets" ] || { echo "cbox: container $target is on no docker network" >&2; return 1; }
        while IFS= read -r net; do
          [ -n "$net" ] || continue
          _netaccess_valid_name "$net" || {
            echo "cbox: container $target is on a network whose name is not a plain [A-Za-z0-9._-] token ('$net') - refusing to expand it" >&2
            return 1
          }
        done <<< "$nets"
        for net in $nets; do
          if [ "$action" = allow ]; then
            out="$(_netaccess_set_add "$netvar" "$net")" && { netvar="$out"; changed=1; echo "cbox: + network $net (whole subnet, from container $target)"; } \
              || echo "cbox: = network $net already allowed (from container $target)"
          else
            if _netaccess_set_has "$netvar" "$net"; then
              netvar="$(_netaccess_set_del "$netvar" "$net")"; changed=1; echo "cbox: - network $net (from container $target)"
            else
              echo "cbox: = network $net was not allowed (from container $target)"
            fi
          fi
        done
        ;;
    esac
  done

  [ "$changed" = 1 ] || { echo "cbox: nothing to change"; return 0; }

  local -a pairs=("CBOX_NETACCESS_NETWORKS=$netvar" "CBOX_NETACCESS_CIDRS=$cidrvar")
  local pin_scope=0
  if [ -z "$netvar" ] && [ -z "$cidrvar" ]; then
    case "${CBOX_NETACCESS_SCOPE:-}" in
      all|list) ;;
      *)
        pin_scope=1
        pairs+=("CBOX_NETACCESS_SCOPE=list")
        echo "cbox: the allowed set is now empty and no explicit scope was set - pinning CBOX_NETACCESS_SCOPE=list"
        echo "cbox: without the pin an empty set falls back to scope=all, which would join every eligible network"
        ;;
    esac
  fi

  out="$(_cbox_config_set "${pairs[@]}" 2>&1)" || {
    printf '%s\n' "$out" >&2
    return 1
  }
  CBOX_NETACCESS_NETWORKS="$netvar"
  CBOX_NETACCESS_CIDRS="$cidrvar"
  [ "$pin_scope" = 1 ] && CBOX_NETACCESS_SCOPE=list
  local arc=0
  _netaccess_apply_now "$mode" "$eff" || arc=$?
  if [ "$arc" = 0 ]; then
    echo "cbox: applied to the running proxy"
    if [ -n "${CBOX_NETACCESS_SKIPPED:-}" ]; then
      local skip_net skip_reason
      while IFS="$(printf '\t')" read -r skip_net skip_reason; do
        [ -n "$skip_net" ] || continue
        printf 'cbox: netaccess: %s is granted but not applied right now (%s)\n' "$skip_net" "$skip_reason" >&2
      done <<<"$CBOX_NETACCESS_SKIPPED"
    fi
    if _cbox_running_cbox_sees_netaccess "$mode" "$eff"; then
      echo "cbox: the running cbox session can reach it now (no restart needed)"
    else
      echo "cbox: NOTE - the running cbox container predates this grant (it is not attached to the internal network / has no CBOX_SOCKS_PROXY in its environment)." >&2
      echo "cbox: the CURRENT session cannot see this grant; a new session started after this point will. To repair the current one: cbox down && cbox run" >&2
    fi
  elif [ "$arc" = 2 ]; then
    :
  elif [ "$action" = deny ]; then
    echo "cbox: DENY NOT ENFORCED - the config records the narrower set, but the running proxy still serves the old, wider rules" >&2
    echo "cbox: close the gap now with 'cbox down' (or re-run this command once docker is healthy)" >&2
    return 1
  else
    echo "cbox: config saved, but applying to the proxy failed - it takes effect on the next 'cbox run'" >&2
    return 1
  fi
}

netaccess_cmd() {
  local sub="${1:-}" mode root eff
  case "$sub" in
    status|allow|deny) ;;
    *)
      echo "cbox: usage: $0 netaccess {status|allow <target>...|deny <target>...}" >&2
      echo "cbox: target is a docker network name, a running container name/id, or an IPv4 CIDR" >&2
      return 1
      ;;
  esac
  shift
  if [ "$sub" != status ]; then
    [ "$#" -ge 1 ] || { echo "cbox: $sub needs at least one target" >&2; return 1; }
    if _cbox_config_in_container; then
      echo "cbox: netaccess $sub is host-only - it changes docker networks and the proxy policy" >&2
      return 1
    fi
  fi
  [ -f "$INSTALL_DIR/templates/sections.sh" ] || die "$INSTALL_DIR/templates/sections.sh missing"
  . "$INSTALL_DIR/templates/sections.sh"
  mode="$(_cbox_effective_mode)"
  case "$mode" in
    global)
      require_global_conf
      if [ "$sub" = status ]; then
        _netaccess_print_status global ""
      else
        _cbox_netaccess_active || die "netaccess is off (CBOX_NETACCESS_MODE=${CBOX_NETACCESS_MODE:-off}, applied=${CBOX_NETACCESS_APPLIED:-0}) - turn it on before granting anything: $0 config set CBOX_NETACCESS_MODE=socks CBOX_NETACCESS_APPLIED=1"
        _netaccess_change "$sub" global "" "$@"
      fi
      ;;
    isolated)
      root="$(_cbox_workspace_root)" || die "refusing to run in $PWD (home, /, or a mount root)"
      eff="$HOME/.config/cbox/projects/$(_cbox_path_hash "$root")"
      [ -f "$eff/cbox.conf" ] || die "no effective config for $root - run 'cbox run codex' or 'cbox setup --local $root' first"
      (
        set -e
        unset CBOX_NETACCESS_SCOPE CBOX_NETACCESS_NETWORKS CBOX_NETACCESS_CIDRS
        . "$eff/cbox.conf"
        if [ "$sub" = status ]; then
          _netaccess_print_status isolated "$eff"
        else
          _cbox_netaccess_active || die "netaccess is off for this project (CBOX_NETACCESS_MODE=${CBOX_NETACCESS_MODE:-off}, applied=${CBOX_NETACCESS_APPLIED:-0}) - turn it on before granting anything: $0 config set CBOX_NETACCESS_MODE=socks CBOX_NETACCESS_APPLIED=1"
          _netaccess_change "$sub" isolated "$eff" "$@"
        fi
      )
      ;;
    *)
      die_no_conf
      ;;
  esac
}

_cbox_ollama_lock_file() {
  printf '%s/.config/cbox/infra/ollama.lock' "$HOME"
}

_cbox_ollama_lock_fd_open() {
  local fd="$1" lockfile="$2"
  if [ -L "$lockfile" ]; then
    echo "cbox: refusing - $lockfile is a symlink, not a plain lock file" >&2
    return 1
  fi
  eval "exec $fd>> \"\$lockfile\""
}

_cbox_ollama_owner_compose() {
  local dir
  dir="$(_cbox_ollama_owner_dir)"
  local -a cmd=(docker compose --project-directory "$dir" -f "$dir/docker-compose.yml")
  if [ -f "$dir/docker-compose.gpu.yml" ]; then
    cmd+=(-f "$dir/docker-compose.gpu.yml")
  fi
  "${cmd[@]}" "$@"
}

_cbox_ollama_guard() {
  if [ "${CBOX_OLLAMA_MODE:-off}" != on ]; then
    echo "cbox: ollama is off (CBOX_OLLAMA_MODE=${CBOX_OLLAMA_MODE:-off}) - turn it on first: $0 config set CBOX_OLLAMA_MODE=on" >&2
    return 1
  fi
  return 0
}

_cbox_ollama_host_daemon_detected() {
  if command -v curl >/dev/null 2>&1 && curl -s -o /dev/null --connect-timeout 1 "http://127.0.0.1:${CBOX_OLLAMA_PORT:-11434}/" 2>/dev/null; then
    return 0
  fi
  if command -v ss >/dev/null 2>&1 && ss -ltn 2>/dev/null | grep -q ":${CBOX_OLLAMA_PORT:-11434} "; then
    return 0
  fi
  if command -v pgrep >/dev/null 2>&1 && pgrep -x ollama >/dev/null 2>&1; then
    return 0
  fi
  if command -v systemctl >/dev/null 2>&1 && systemctl is-active --quiet ollama 2>/dev/null; then
    return 0
  fi
  return 1
}

_cbox_ollama_adopt_or_refuse() {
  local dir="$1" name cid labels project image want_image
  name="$(_cbox_ollama_owner_name)"
  cid="$(docker ps -a --filter "name=^/${name}-ollama-" --format '{{.ID}}' 2>/dev/null | head -n1)"
  if [ -z "$cid" ]; then
    cid="$(docker ps -a --filter "label=cbox.owner=$name" --filter "label=cbox.component=ollama" --format '{{.ID}}' 2>/dev/null | head -n1)"
  fi
  [ -n "$cid" ] || return 0
  labels="$(docker inspect --format '{{index .Config.Labels "cbox.kind"}}|{{index .Config.Labels "cbox.component"}}|{{index .Config.Labels "cbox.owner"}}' "$cid" 2>/dev/null)" || labels=""
  case "$labels" in
    infra\|ollama\|"$name")
      project="$(docker inspect --format '{{index .Config.Labels "com.docker.compose.project"}}' "$cid" 2>/dev/null)" || project=""
      if [ -n "$project" ] && [ "$project" != "$name" ]; then
        echo "cbox: refusing - a container ($cid) carries cbox ollama labels for $name but belongs to compose project '$project', not '$name'; remove it before running cbox ollama up" >&2
        return 1
      fi
      image="$(docker inspect --format '{{.Config.Image}}' "$cid" 2>/dev/null)" || image=""
      want_image="${CBOX_OLLAMA_IMAGE:-ollama/ollama:0.32.5}"
      if [ -n "$image" ] && [ "$image" != "$want_image" ]; then
        echo "cbox: found an existing container ($cid) owned by $name but its image ($image) does not match the configured CBOX_OLLAMA_IMAGE ($want_image) - run 'cbox ollama reconcile' to recreate it" >&2
        return 0
      fi
      if _cbox_ollama_manifest_matches_current "$dir"; then
        return 0
      fi
      echo "cbox: found an existing container ($cid) owned by $name but the ownership manifest does not match the current config - run 'cbox ollama reconcile' to update it" >&2
      return 0
      ;;
    *)
      echo "cbox: refusing - a container ($cid) already uses the name/labels cbox expects for $name but is not cbox-owned (labels: ${labels:-none}); remove it or rename it before running cbox ollama up" >&2
      return 1
      ;;
  esac
}

_cbox_ollama_status_cmd() {
  local dir cid state
  dir="$(_cbox_ollama_owner_dir)"
  if [ "${CBOX_OLLAMA_MODE:-off}" != on ]; then
    echo "ollama: OFF (CBOX_OLLAMA_MODE=off)"
    return 0
  fi
  if [ ! -f "$dir/docker-compose.yml" ]; then
    echo "ollama: CONFIG-ONLY (CBOX_OLLAMA_MODE=on, owner project not yet rendered - run 'cbox ollama reconcile')"
    return 0
  fi
  cid="$(_cbox_ollama_owner_compose ps -q ollama 2>/dev/null)" || cid=""
  if [ -z "$cid" ]; then
    echo "ollama: CONFIG-ONLY (CBOX_OLLAMA_MODE=on, owner project rendered but not running - run 'cbox ollama up')"
    return 0
  fi
  state="$(docker inspect --format '{{.State.Status}}' "$cid" 2>/dev/null)" || state=unknown
  echo "ollama: ACTIVE (container $cid, state=$state, owner=$(_cbox_ollama_owner_name), store=${CBOX_OLLAMA_STORE:-dedicated}, gpu=${CBOX_OLLAMA_GPU:-off}, port=${CBOX_OLLAMA_PORT:-11434})"
}

_cbox_ollama_shared_store_guard() {
  [ "${CBOX_OLLAMA_STORE:-dedicated}" = shared ] || return 0
  [ -n "${CBOX_OLLAMA_STORE_PATH:-}" ] || { echo "cbox: CBOX_OLLAMA_STORE=shared needs CBOX_OLLAMA_STORE_PATH set" >&2; return 1; }
  local models_dir="${CBOX_OLLAMA_STORE_PATH}/models"
  if [ -L "$models_dir" ]; then
    echo "cbox: refusing - $models_dir is a symlink, not a real directory" >&2
    return 1
  fi
  if [ ! -d "$models_dir" ]; then
    echo "cbox: refusing - $models_dir does not exist yet; create it (owned by you) before using CBOX_OLLAMA_STORE=shared" >&2
    return 1
  fi
  local owner_uid
  owner_uid="$(_cbox_stat_uid -- "$models_dir" 2>/dev/null)" || owner_uid=""
  if [ -z "$owner_uid" ] || [ "$owner_uid" != "$(id -u)" ]; then
    echo "cbox: refusing - $models_dir is not owned by the invoking user (uid $(id -u))" >&2
    return 1
  fi
  if _cbox_ollama_host_daemon_detected; then
    echo "cbox: refusing - a host ollama daemon appears to be running (port ${CBOX_OLLAMA_PORT:-11434}, process, or systemd unit) and CBOX_OLLAMA_STORE=shared would race it on the same model directory - stop the host daemon first" >&2
    return 1
  fi
  return 0
}

_cbox_ollama_reconcile_cmd() {
  local dir
  dir="$(_cbox_ollama_owner_dir)"
  mkdir -p "$dir"
  if [ "${CBOX_OLLAMA_MODE:-off}" != on ] && ! _cbox_wg_active; then
    if [ -f "$dir/docker-compose.yml" ]; then
      _cbox_ollama_owner_compose down >/dev/null 2>&1 || true
    fi
    gen_ollama_owner_compose_into "$dir"
    gen_wireguard_conf
    rm -f "$dir/ownership.manifest"
    _cbox_ollama_gc_scope_networks_impl
    echo "cbox: ollama reconcile: mode is off - owner project torn down and de-rendered"
    return 0
  fi
  if [ "${CBOX_OLLAMA_MODE:-off}" = on ]; then
    _cbox_ollama_shared_store_guard || return 1
    _cbox_ollama_adopt_or_refuse "$dir" || return 1
  fi
  if _cbox_wg_active; then
    [ -n "${CBOX_WG_ADDRESS:-}" ] || { echo "cbox: refusing - CBOX_WG_MODE=${CBOX_WG_MODE} but CBOX_WG_ADDRESS is empty; set it (this node's tunnel address in CIDR form) before bringing the sidecar up" >&2; return 1; }
    _cbox_wg_ensure_keys || return 1
    if _cbox_wg_server_role; then
      command -v wg >/dev/null 2>&1 || { echo "cbox: refusing - CBOX_WG_MODE=${CBOX_WG_MODE} but wireguard-tools ('wg') is not installed on this host" >&2; return 1; }
    fi
    [ -e /dev/net/tun ] || echo "cbox: warning - /dev/net/tun not present on this host; the wireguard sidecar will fail to start until it is available (kernel module 'tun' or equivalent)" >&2
  fi
  gen_ollama_owner_compose_into "$dir"
  gen_wireguard_conf
  _cbox_ollama_manifest_write "$dir"
  _cbox_ollama_owner_compose up -d --remove-orphans
  _cbox_ollama_reconcile_networks_impl || echo "cbox: ollama reconcile: owner project is up but per-scope network reconciliation reported an error - run 'cbox ollama reconcile' again" >&2
  if [ "${CBOX_OLLAMA_MODE:-off}" = on ]; then
    echo "cbox: ollama reconcile: owner project $(_cbox_ollama_owner_name) applied at $dir"
  else
    echo "cbox: ollama reconcile: owner project $(_cbox_ollama_owner_name) applied at $dir (ollama off, wireguard sidecar only)"
  fi
}

_cbox_ollama_up_cmd() {
  local dir
  dir="$(_cbox_ollama_owner_dir)"
  if [ ! -f "$dir/docker-compose.yml" ] || ! _cbox_ollama_manifest_matches_current "$dir"; then
    _cbox_ollama_reconcile_cmd || return 1
    return 0
  fi
  _cbox_ollama_shared_store_guard || return 1
  _cbox_ollama_adopt_or_refuse "$dir" || return 1
  _cbox_ollama_owner_compose up -d --remove-orphans
  _cbox_ollama_reconcile_networks_impl || echo "cbox: ollama up: per-scope network reconciliation reported an error - run 'cbox ollama reconcile' again" >&2
}

_cbox_ollama_down_cmd() {
  local dir
  dir="$(_cbox_ollama_owner_dir)"
  [ -f "$dir/docker-compose.yml" ] || { echo "cbox: ollama owner project not rendered - nothing to stop" >&2; return 0; }
  _cbox_ollama_owner_compose down
  _cbox_ollama_gc_scope_networks_impl
}

_cbox_ollama_model_ref_ok() {
  case "$1" in
    ''|*[!A-Za-z0-9._:/@-]*) return 1 ;;
    *) return 0 ;;
  esac
}

_cbox_ollama_pull_cmd() {
  local dir model rc=0
  model="${1:-}"
  [ -n "$model" ] || { echo "cbox: usage: $0 ollama pull <model>" >&2; return 1; }
  _cbox_ollama_model_ref_ok "$model" || { echo "cbox: refusing - model reference '$model' contains characters other than [A-Za-z0-9._:/@-]" >&2; return 1; }
  dir="$(_cbox_ollama_owner_dir)"
  [ -f "$dir/docker-compose.yml" ] || { echo "cbox: ollama owner project not rendered - run 'cbox ollama reconcile' first" >&2; return 1; }
  _cbox_ollama_shared_store_guard || return 1
  local net container
  net="cbox-ollama-pull-$(id -u)-$$-$(date +%s%N 2>/dev/null || echo 0)"
  container="cbox-ollama-pull-$(id -u)-$$"
  echo "cbox: ollama pull: stopping the serving container for the duration of the pull (no permanent egress on the running server)" >&2
  _cbox_ollama_owner_compose stop ollama >/dev/null 2>&1 || true
  _restore_ollama() {
    docker rm -f -- "$container" >/dev/null 2>&1 || true
    docker network rm -- "$net" >/dev/null 2>&1 || true
    _cbox_ollama_owner_compose up -d ollama >/dev/null 2>&1 || true
    _cbox_ollama_reconcile_networks_impl >/dev/null 2>&1 || true
  }
  trap _restore_ollama EXIT INT TERM
  if ! docker network create --label cbox.kind=infra --label cbox.component=ollama-pull -- "$net" >/dev/null 2>&1; then
    echo "cbox: failed to create the temporary pull network $net" >&2
    trap - EXIT INT TERM
    _restore_ollama
    return 1
  fi
  if ! _cbox_ollama_owner_compose run -d --rm --no-deps --name "$container" -e OLLAMA_HOST=127.0.0.1:11434 --entrypoint sh ollama -c \
    'ollama serve >/tmp/ollama-pull.log 2>&1; sleep infinity' >/dev/null 2>&1; then
    echo "cbox: failed to start the temporary pull container" >&2
    trap - EXIT INT TERM
    _restore_ollama
    return 1
  fi
  if ! docker network connect -- "$net" "$container" >/dev/null 2>&1; then
    echo "cbox: failed to attach the temporary pull network to the pull container" >&2
    trap - EXIT INT TERM
    _restore_ollama
    return 1
  fi
  docker exec -- "$container" sh -c \
    'for i in $(seq 1 30); do curl -sf http://127.0.0.1:11434/ >/dev/null 2>&1 && break; sleep 1; done; ollama pull "$1"' \
    cbox-pull "$model" || rc=$?
  trap - EXIT INT TERM
  _restore_ollama
  return "$rc"
}

_cbox_ollama_scope_network_name() {
  local scope="$1" p_hash="${2:-}"
  if [ "$scope" = global ]; then
    printf 'cbox-ollama-u%s-global' "$(id -u)"
  else
    printf 'cbox-ollama-u%s-p%s' "$(id -u)" "$p_hash"
  fi
}

_cbox_ollama_network_labels_ok() {
  local name="$1" labels want_owner
  want_owner="$(_cbox_ollama_owner_name)"
  labels="$(docker network inspect --format '{{.Internal}}|{{index .Labels "cbox.kind"}}|{{index .Labels "cbox.component"}}|{{index .Labels "cbox.owner"}}' "$name" 2>/dev/null)" || return 1
  [ "$labels" = "true|infra|ollama-net|$want_owner" ]
}

_cbox_ollama_ensure_scope_network() {
  local name="$1"
  if docker network inspect -- "$name" >/dev/null 2>&1; then
    if ! _cbox_ollama_network_labels_ok "$name"; then
      echo "cbox: refusing - a docker network named $name already exists but is not cbox-owned ollama infrastructure" >&2
      return 1
    fi
    return 0
  fi
  docker network create --internal \
    --label cbox.kind=infra \
    --label cbox.component=ollama-net \
    --label cbox.owner="$(_cbox_ollama_owner_name)" \
    -- "$name" >/dev/null
}

_cbox_ollama_endpoint_networks() {
  docker inspect --type container --format '{{range $k, $v := .NetworkSettings.Networks}}{{$k}}{{"\n"}}{{end}}' -- "$1" 2>/dev/null | sed '/^$/d'
}

_cbox_ollama_connect_scope_network() {
  local netname="$1" ollama_cid="$2" cbox_cid="$3"
  local ollama_nets cbox_nets connected_ollama=0 connected_cbox=0
  ollama_nets="$(_cbox_ollama_endpoint_networks "$ollama_cid")"
  cbox_nets="$(_cbox_ollama_endpoint_networks "$cbox_cid")"
  if ! printf '%s\n' "$ollama_nets" | grep -qxF "$netname"; then
    if docker network connect --alias ollama -- "$netname" "$ollama_cid" >/dev/null 2>&1; then
      connected_ollama=1
    else
      echo "cbox: failed to attach ollama to $netname" >&2
      return 1
    fi
  fi
  if ! printf '%s\n' "$cbox_nets" | grep -qxF "$netname"; then
    if ! docker network connect -- "$netname" "$cbox_cid" >/dev/null 2>&1; then
      echo "cbox: failed to attach $cbox_cid to $netname" >&2
      if [ "$connected_ollama" = 1 ]; then
        docker network disconnect -f -- "$netname" "$ollama_cid" >/dev/null 2>&1 || true
      fi
      return 1
    fi
    connected_cbox=1
  fi
  return 0
}

_cbox_wg_infra_default_network() {
  local owner="$1"
  docker network ls --filter "label=com.docker.compose.project=$owner" --filter "label=com.docker.compose.network=default" --format '{{.Name}}' 2>/dev/null | head -n1
}

_cbox_wg_connect_client_alias() {
  local cbox_cid="$1" owner netname cbox_nets
  _cbox_wg_active && _cbox_wg_client_role || return 0
  owner="$(_cbox_ollama_owner_name)"
  netname="$(_cbox_wg_infra_default_network "$owner")"
  [ -n "$netname" ] || return 0
  cbox_nets="$(_cbox_ollama_endpoint_networks "$cbox_cid")"
  printf '%s\n' "$cbox_nets" | grep -qxF "$netname" && return 0
  docker network connect -- "$netname" "$cbox_cid" >/dev/null 2>&1 || {
    echo "cbox: failed to attach $cbox_cid to the wireguard client alias network $netname" >&2
    return 1
  }
}

_cbox_ollama_reconcile_one_scope() {
  local scope="$1" cbox_cid="$2" p_hash="${3:-}" ollama_cid="$4" netname
  netname="$(_cbox_ollama_scope_network_name "$scope" "$p_hash")"
  _cbox_ollama_ensure_scope_network "$netname" || return 1
  _cbox_ollama_connect_scope_network "$netname" "$ollama_cid" "$cbox_cid" || return 1
  _cbox_wg_connect_client_alias "$cbox_cid"
}

_cbox_ollama_disconnect_stale_scope_networks() {
  local owner="$1" name endpoint_count endpoint_name
  docker network ls --filter label=cbox.component=ollama-net --filter "label=cbox.owner=$owner" --format '{{.Name}}' 2>/dev/null | while IFS= read -r name; do
    [ -n "$name" ] || continue
    case "$name" in
      *-global) continue ;;
    esac
    endpoint_count="$(docker network inspect --format '{{len .Containers}}' -- "$name" 2>/dev/null)" || continue
    [ "${endpoint_count:-0}" = 1 ] || continue
    endpoint_name="$(docker network inspect --format '{{range $k, $v := .Containers}}{{$v.Name}}{{"\n"}}{{end}}' -- "$name" 2>/dev/null | grep 'ollama' | head -n1)"
    if [ -n "$endpoint_name" ]; then
      docker network disconnect -- "$name" "$endpoint_name" >/dev/null 2>&1 || true
    fi
  done
}

_cbox_ollama_reconcile_networks_impl() {
  [ "${CBOX_OLLAMA_MODE:-off}" = on ] || return 0
  local dir ollama_cid rc=0
  dir="$(_cbox_ollama_owner_dir)"
  [ -f "$dir/docker-compose.yml" ] || return 0
  ollama_cid="$(_cbox_ollama_owner_compose ps -q ollama 2>/dev/null)" || ollama_cid=""
  [ -n "$ollama_cid" ] || return 0
  local cid
  cid="$("${COMPOSE[@]}" ps -q "$SERVICE" 2>/dev/null)" || cid=""
  if [ -n "$cid" ]; then
    _cbox_ollama_reconcile_one_scope global "$cid" "" "$ollama_cid" || rc=1
  fi
  local phash effdir
  while IFS="$(printf '\t')" read -r cid phash; do
    [ -n "$cid" ] || continue
    [ -n "$phash" ] || continue
    _cbox_ollama_reconcile_one_scope isolated "$cid" "$phash" "$ollama_cid" || rc=1
  done < <(docker ps --filter label=cbox.kind=isolated --format '{{.ID}}'$'\t''{{.Label "cbox.phash"}}' 2>/dev/null)
  _cbox_ollama_disconnect_stale_scope_networks "$(_cbox_ollama_owner_name)"
  return "$rc"
}

_cbox_gc_orphan_proxy_networks() {
  local name endpoints
  docker network ls --filter label=cbox.kind=proxy-net --format '{{.Name}}' 2>/dev/null | while IFS= read -r name; do
    [ -n "$name" ] || continue
    endpoints="$(docker network inspect --format '{{len .Containers}}' -- "$name" 2>/dev/null)" || continue
    if [ "${endpoints:-0}" = 0 ]; then
      docker network rm -- "$name" >/dev/null 2>&1 || true
    fi
  done
}

_cbox_ollama_gc_scope_networks_impl() {
  local name endpoints owner
  owner="$(_cbox_ollama_owner_name)"
  docker network ls --filter label=cbox.component=ollama-net --filter "label=cbox.owner=$owner" --format '{{.Name}}' 2>/dev/null | while IFS= read -r name; do
    [ -n "$name" ] || continue
    endpoints="$(docker network inspect --format '{{len .Containers}}' -- "$name" 2>/dev/null)" || continue
    if [ "${endpoints:-0}" = 0 ]; then
      docker network rm -- "$name" >/dev/null 2>&1 || true
    fi
  done
}

_cbox_ollama_reconcile_networks() {
  local lockfile rc=0
  mkdir -p "$HOME/.config/cbox/infra"
  lockfile="$(_cbox_ollama_lock_file)"
  _cbox_ollama_lock_fd_open 9 "$lockfile" || return 1
  if ! _cbox_flock -x -w 30 9; then
    echo "cbox: could not lock $lockfile for network reconciliation" >&2
    exec 9>&-
    return 1
  fi
  _cbox_ollama_reconcile_networks_impl || rc=1
  exec 9>&-
  return "$rc"
}

_cbox_ollama_gc_scope_networks() {
  local lockfile rc=0
  mkdir -p "$HOME/.config/cbox/infra"
  lockfile="$(_cbox_ollama_lock_file)"
  _cbox_ollama_lock_fd_open 9 "$lockfile" || return 1
  if ! _cbox_flock -x -w 30 9; then
    echo "cbox: could not lock $lockfile for network gc" >&2
    exec 9>&-
    return 1
  fi
  _cbox_ollama_gc_scope_networks_impl || rc=1
  exec 9>&-
  return "$rc"
}

ollama_cmd() {
  local sub="${1:-}"
  case "$sub" in
    status|up|down|pull|reconcile) ;;
    *)
      echo "cbox: usage: $0 ollama {status|up|down|pull <model>|reconcile}" >&2
      return 1
      ;;
  esac
  shift
  if _cbox_config_in_container; then
    echo "cbox: ollama $sub is host-only - it manages the machine-scoped owner compose project" >&2
    return 1
  fi
  [ -f "$INSTALL_DIR/templates/sections.sh" ] || die "$INSTALL_DIR/templates/sections.sh missing"
  . "$INSTALL_DIR/templates/sections.sh"
  if [ "$sub" != status ]; then
    _cbox_ollama_guard || return 1
  fi
  mkdir -p "$HOME/.config/cbox/infra"
  local lockfile rc=0
  lockfile="$(_cbox_ollama_lock_file)"
  _cbox_ollama_lock_fd_open 6 "$lockfile" || return 1
  case "$sub" in
    status)
      _cbox_flock -s -w 30 6 || { echo "cbox: cannot lock $lockfile" >&2; exec 6>&-; return 1; }
      _cbox_ollama_status_cmd || rc=$?
      ;;
    up)
      _cbox_flock -x -w 30 6 || { echo "cbox: cannot lock $lockfile" >&2; exec 6>&-; return 1; }
      _cbox_ollama_up_cmd || rc=$?
      ;;
    down)
      _cbox_flock -x -w 30 6 || { echo "cbox: cannot lock $lockfile" >&2; exec 6>&-; return 1; }
      _cbox_ollama_down_cmd || rc=$?
      ;;
    pull)
      _cbox_flock -x -w 30 6 || { echo "cbox: cannot lock $lockfile" >&2; exec 6>&-; return 1; }
      _cbox_ollama_pull_cmd "$@" || rc=$?
      ;;
    reconcile)
      _cbox_flock -x -w 30 6 || { echo "cbox: cannot lock $lockfile" >&2; exec 6>&-; return 1; }
      _cbox_ollama_reconcile_cmd || rc=$?
      ;;
  esac
  exec 6>&-
  return "$rc"
}

_cbox_wg_guard() {
  if ! _cbox_wg_active; then
    echo "cbox: wireguard is off (CBOX_WG_MODE=${CBOX_WG_MODE:-off}) - turn it on first: $0 config set CBOX_WG_MODE=server (or client, or both)" >&2
    return 1
  fi
  return 0
}

_cbox_wg_owner_container_id() {
  _cbox_ollama_owner_compose ps -q wireguard 2>/dev/null
}

_cbox_wg_status_cmd() {
  local dir cid state impl handshake_out line iface listen_port
  dir="$(_cbox_ollama_owner_dir)"
  if ! _cbox_wg_active; then
    echo "wireguard: OFF (CBOX_WG_MODE=off)"
    return 0
  fi
  if [ ! -f "$dir/docker-compose.yml" ]; then
    echo "wireguard: CONFIG-ONLY (CBOX_WG_MODE=${CBOX_WG_MODE}, owner project not yet rendered - run 'cbox wg up')"
    return 0
  fi
  cid="$(_cbox_wg_owner_container_id)" || cid=""
  if [ -z "$cid" ]; then
    echo "wireguard: CONFIG-ONLY (CBOX_WG_MODE=${CBOX_WG_MODE}, owner project rendered but not running - run 'cbox wg up')"
    return 0
  fi
  state="$(docker inspect --format '{{.State.Status}}' "$cid" 2>/dev/null)" || state=unknown
  if [ "$state" != running ]; then
    echo "wireguard: CONFIG-ONLY (container $cid present but state=$state - run 'cbox wg up')"
    return 0
  fi
  iface="$(_cbox_wg_iface)"
  listen_port="${CBOX_WG_LISTEN_PORT:-51820}"
  impl="$(docker exec "$cid" cat /run/cbox-wg/impl 2>/dev/null)" || impl=""
  case "$impl" in
    kernel|userspace) ;;
    *) impl="unknown" ;;
  esac
  echo "wireguard: ACTIVE (container $cid, mode=${CBOX_WG_MODE}, interface=$iface, implementation=$impl, listen_port=$listen_port)"
  if _cbox_wg_server_role; then
    handshake_out="$(docker exec "$cid" wg show "$iface" latest-handshakes 2>/dev/null)" || handshake_out=""
    if [ -z "$handshake_out" ]; then
      echo "  peers: none configured, or interface not readable"
    else
      local line pname ppub paddr hs_pub hs_time
      while IFS= read -r line; do
        [ -n "$line" ] || continue
        pname="$(_cbox_wg_peer_field "$line" 0)"
        ppub="$(_cbox_wg_peer_field "$line" 1)"
        paddr="$(_cbox_wg_peer_field "$line" 2)"
        hs_time="$(printf '%s\n' "$handshake_out" | awk -v k="$ppub" '$1==k{print $2}')"
        if [ -z "$hs_time" ] || [ "$hs_time" = "0" ]; then
          echo "  peer $pname ($paddr): no handshake yet"
        else
          local now age
          now="$(date +%s)"
          age=$((now - hs_time))
          echo "  peer $pname ($paddr): last handshake ${age}s ago"
        fi
      done < <(_cbox_wg_peer_list)
    fi
  fi
  echo "  note: under rootless docker a peer's displayed endpoint (via 'wg show' inside the sidecar) may show the rootless port forwarder's address, not the peer's true remote address - authentication is by public key regardless"
  return 0
}

_cbox_wg_up_cmd() {
  local dir
  dir="$(_cbox_ollama_owner_dir)"
  _cbox_wg_ensure_keys || return 1
  if _cbox_wg_server_role; then
    command -v wg >/dev/null 2>&1 || { echo "cbox: refusing - CBOX_WG_MODE=${CBOX_WG_MODE} but wireguard-tools ('wg') is not installed on this host" >&2; return 1; }
  fi
  [ -e /dev/net/tun ] || echo "cbox: warning - /dev/net/tun not present on this host; the wireguard sidecar needs it (kernel module 'tun' or equivalent) and will fail to start without it" >&2
  _cbox_ollama_reconcile_cmd
}

_cbox_wg_down_cmd() {
  local dir cid
  dir="$(_cbox_ollama_owner_dir)"
  [ -f "$dir/docker-compose.yml" ] || { echo "cbox: wireguard owner service not rendered - nothing to stop" >&2; return 0; }
  cid="$(_cbox_wg_owner_container_id)" || cid=""
  if [ -z "$cid" ]; then
    echo "cbox: wireguard sidecar is not running" >&2
    return 0
  fi
  _cbox_ollama_owner_compose stop wireguard
}

_cbox_wg_keygen_cmd() {
  _cbox_wg_keygen && echo "cbox: wireguard keypair generated/verified at $(_cbox_wg_dir) (private key 0600, never printed)"
}

_cbox_wg_reload_or_restart() {
  local dir cid iface
  dir="$(_cbox_ollama_owner_dir)"
  gen_wireguard_conf
  [ -f "$dir/docker-compose.yml" ] || return 0
  cid="$(_cbox_wg_owner_container_id)" || cid=""
  [ -n "$cid" ] || return 0
  iface="$(_cbox_wg_iface)"
  if docker exec "$cid" sh -c "command -v wg-quick >/dev/null 2>&1 && ip link show dev $iface >/dev/null 2>&1"; then
    local runtime_conf strip_conf
    runtime_conf="$(_cbox_wg_runtime_conf_path)"
    strip_conf="$(dirname "$runtime_conf")/strip.conf"
    if docker exec "$cid" sh -c "umask 0077; priv=\$(cat /etc/cbox-generated/wireguard/privatekey); sed \"s#__CBOX_WG_PRIVATE_KEY__#\$priv#\" /etc/cbox-generated/wireguard/$iface.conf.tpl > $runtime_conf; chmod 0600 $runtime_conf; wg-quick strip $runtime_conf > $strip_conf; wg syncconf $iface $strip_conf; rm -f $strip_conf" >/dev/null 2>&1; then
      echo "cbox: wireguard peers reloaded on the running interface without dropping other peers"
      return 0
    fi
  fi
  echo "cbox: could not reload the running interface in place - restarting the wireguard sidecar instead"
  _cbox_ollama_owner_compose restart wireguard
}

_cbox_wg_peer_add_cmd() {
  local name="$1" pubkey="$2" addr="$3"
  shift 3 2>/dev/null || true
  local endpoint="" capability=""
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --endpoint)
        endpoint="${2:-}"
        shift 2
        ;;
      --capability)
        capability="${2:-}"
        shift 2
        ;;
      *)
        echo "cbox: usage: $0 wg peer add <name> <pubkey> <tunnel-host-address/32> [--endpoint host:port] [--capability none|ollama|session|ollama,session]" >&2
        return 1
        ;;
    esac
  done
  if [ -z "$name" ] || [ -z "$pubkey" ] || [ -z "$addr" ]; then
    echo "cbox: usage: $0 wg peer add <name> <pubkey> <tunnel-host-address/32> [--endpoint host:port] [--capability none|ollama|session|ollama,session]" >&2
    return 1
  fi
  _cbox_wg_peer_add "$name" "$pubkey" "$addr" "$endpoint" "$capability" || return 1
  if [ -n "$endpoint" ]; then
    echo "cbox: client-role peer '$name' added (this node dials $endpoint)"
  else
    echo "cbox: server-role peer '$name' added (this peer dials this node)"
  fi
  _cbox_wg_reload_or_restart
}

_cbox_wg_peer_rm_cmd() {
  local name="$1"
  if [ -z "$name" ]; then
    echo "cbox: usage: $0 wg peer rm <name>" >&2
    return 1
  fi
  _cbox_wg_peer_remove "$name" || return 1
  echo "cbox: peer '$name' removed"
  _cbox_wg_reload_or_restart
}

_cbox_wg_peer_list_cmd() {
  local line pname ppub paddr pendpoint pcap role found=0
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    found=1
    pname="$(_cbox_wg_peer_field "$line" 0)"
    ppub="$(_cbox_wg_peer_field "$line" 1)"
    paddr="$(_cbox_wg_peer_field "$line" 2)"
    pendpoint="$(_cbox_wg_peer_endpoint "$line")"
    pcap="$(_cbox_wg_peer_capability "$line")"
    if [ -n "$pendpoint" ]; then
      role="client (dials $pendpoint)"
    else
      role="server (dials us)"
    fi
    echo "$pname  $ppub  $paddr  role=$role  capability=$pcap"
  done < <(_cbox_wg_peer_list)
  [ "$found" = 1 ] || echo "cbox: no peers configured"
  return 0
}

_cbox_wg_peer_config_cmd() {
  local name="$1" genkey="${2:-}"
  if [ -z "$name" ]; then
    echo "cbox: usage: $0 wg peer config <name> [--generate-key]" >&2
    return 1
  fi
  local line pname ppub paddr found=0
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    pname="$(_cbox_wg_peer_field "$line" 0)"
    if [ "$pname" = "$name" ]; then
      ppub="$(_cbox_wg_peer_field "$line" 1)"
      paddr="$(_cbox_wg_peer_field "$line" 2)"
      found=1
      break
    fi
  done < <(_cbox_wg_peer_list)
  [ "$found" = 1 ] || { echo "cbox: no peer named '$name' found" >&2; return 1; }
  _cbox_wg_ensure_keys || return 1
  local my_pub endpoint_host
  my_pub="$(_cbox_wg_pubkey)" || { echo "cbox: this node has no wireguard public key yet - run 'cbox wg keygen' first" >&2; return 1; }
  endpoint_host="${CBOX_WG_PUBLISH_ADDR:-<this-machine-address>}"
  echo "# paste this on the '$name' machine, in its own cbox.conf or wg config"
  echo "# preferred: let '$name' generate its own private key locally and only send you the public key with 'cbox wg peer add'"
  echo "[Peer]"
  if [ "$genkey" = "--generate-key" ]; then
    echo "cbox: --generate-key requested - generating a private key for peer '$name' on THIS machine (not the documented preference; the peer generating its own key is preferred)" >&2
    local tmp_priv tmp_pub
    _cbox_wg_tools_available || { echo "cbox: wireguard-tools ('wg') not found on this host - cannot generate a key" >&2; return 1; }
    tmp_priv="$(wg genkey)"
    tmp_pub="$(printf '%s' "$tmp_priv" | wg pubkey)"
    echo "# generated private key for '$name' - copy this to the peer's machine and delete it from here; it is never stored by cbox"
    echo "PrivateKey = $tmp_priv"
    echo "# this node's [Peer] entry to use $name's newly generated public key: $tmp_pub"
  fi
  echo "PublicKey = $my_pub"
  echo "Endpoint = ${endpoint_host}:${CBOX_WG_LISTEN_PORT:-51820}"
  echo "AllowedIPs = $paddr"
  [ "${CBOX_WG_KEEPALIVE:-25}" -gt 0 ] 2>/dev/null && echo "PersistentKeepalive = ${CBOX_WG_KEEPALIVE}"
  return 0
}

wg_cmd() {
  local sub="${1:-}" sub2="${2:-}"
  case "$sub" in
    status|up|down|keygen) ;;
    peer)
      case "$sub2" in
        add|rm|list|config) ;;
        *)
          echo "cbox: usage: $0 wg peer {add <name> <pubkey> <addr>|rm <name>|list|config <name> [--generate-key]}" >&2
          return 1
          ;;
      esac
      ;;
    *)
      echo "cbox: usage: $0 wg {status|up|down|keygen|peer {add|rm|list|config}}" >&2
      return 1
      ;;
  esac
  shift
  if _cbox_config_in_container; then
    echo "cbox: wg $sub is host-only - it manages the machine-scoped owner compose project" >&2
    return 1
  fi
  [ -f "$INSTALL_DIR/templates/sections.sh" ] || die "$INSTALL_DIR/templates/sections.sh missing"
  . "$INSTALL_DIR/templates/sections.sh"
  if [ "$sub" != status ]; then
    _cbox_wg_guard || return 1
  fi
  mkdir -p "$HOME/.config/cbox/infra"
  local lockfile rc=0
  lockfile="$(_cbox_ollama_lock_file)"
  _cbox_ollama_lock_fd_open 6 "$lockfile" || return 1
  case "$sub" in
    status)
      _cbox_flock -s -w 30 6 || { echo "cbox: cannot lock $lockfile" >&2; exec 6>&-; return 1; }
      _cbox_wg_status_cmd || rc=$?
      ;;
    up)
      _cbox_flock -x -w 30 6 || { echo "cbox: cannot lock $lockfile" >&2; exec 6>&-; return 1; }
      _cbox_wg_up_cmd || rc=$?
      ;;
    down)
      _cbox_flock -x -w 30 6 || { echo "cbox: cannot lock $lockfile" >&2; exec 6>&-; return 1; }
      _cbox_wg_down_cmd || rc=$?
      ;;
    keygen)
      _cbox_flock -x -w 30 6 || { echo "cbox: cannot lock $lockfile" >&2; exec 6>&-; return 1; }
      _cbox_wg_keygen_cmd || rc=$?
      ;;
    peer)
      shift
      case "$sub2" in
        add)
          _cbox_flock -x -w 30 6 || { echo "cbox: cannot lock $lockfile" >&2; exec 6>&-; return 1; }
          _cbox_wg_peer_add_cmd "$@" || rc=$?
          ;;
        rm)
          _cbox_flock -x -w 30 6 || { echo "cbox: cannot lock $lockfile" >&2; exec 6>&-; return 1; }
          _cbox_wg_peer_rm_cmd "$@" || rc=$?
          ;;
        list)
          _cbox_flock -s -w 30 6 || { echo "cbox: cannot lock $lockfile" >&2; exec 6>&-; return 1; }
          _cbox_wg_peer_list_cmd || rc=$?
          ;;
        config)
          _cbox_flock -x -w 30 6 || { echo "cbox: cannot lock $lockfile" >&2; exec 6>&-; return 1; }
          _cbox_wg_peer_config_cmd "$@" || rc=$?
          ;;
      esac
      ;;
  esac
  exec 6>&-
  return "$rc"
}

_cbox_session_broker_tier() {
  case "${CBOX_SESSION_BROKER_MODE:-disabled}" in
    disabled|viewer|full-attach) printf '%s' "${CBOX_SESSION_BROKER_MODE:-disabled}" ;;
    *) printf 'disabled' ;;
  esac
}

_cbox_sshd_target_effdir() {
  local mode root
  mode="$(_cbox_effective_mode)"
  case "$mode" in
    isolated)
      root="$(_cbox_workspace_root)" || die "refusing to operate in $PWD (home, /, or a mount root)"
      printf '%s' "$(_cbox_local_effdir_for "$root")"
      ;;
    global)
      printf '%s' "$INSTALL_DIR"
      ;;
    *)
      die_no_conf
      ;;
  esac
}

_cbox_session_broker_status_cmd() {
  local tier eff
  tier="$(_cbox_session_broker_tier)"
  if [ "$tier" = disabled ]; then
    echo "session-broker: OFF (CBOX_SESSION_BROKER_MODE=disabled) - no sshd config rendered, no port published, no keys generated"
    return 0
  fi
  eff="$(_cbox_sshd_target_effdir)" || return 1
  echo "session-broker: CONFIG-ONLY (tier=$tier) - sshd runs inside the container itself, started by its own entrypoint; this is a host-side view of what will be rendered on the next 'cbox up'/'cbox run'"
  echo "  listen: ${CBOX_SSHD_LISTEN_ADDR:-<unset - render will refuse>}:${CBOX_SSHD_PORT:-2222}"
  if [ -f "$eff/sshd_config" ]; then
    echo "  sshd_config: $eff/sshd_config (rendered)"
  else
    echo "  sshd_config: not yet rendered - run 'cbox up' or 'cbox run' to render it"
  fi
  if [ -s "$eff/sshd-authorized_keys" ]; then
    echo "  authorized_keys: $eff/sshd-authorized_keys ($(grep -c . "$eff/sshd-authorized_keys" 2>/dev/null || echo 0) line(s))"
  else
    echo "  authorized_keys: $eff/sshd-authorized_keys is empty - no key admitted, nobody can connect regardless of tier"
  fi
  if [ -f "$eff/sshd-access/level" ]; then
    echo "  access level on disk: $(cat "$eff/sshd-access/level" 2>/dev/null)"
  fi
  return 0
}

_cbox_session_broker_access_cmd() {
  local level="${1:-}" eff
  case "$level" in
    disabled|viewer|full-attach) ;;
    *) echo "cbox: usage: $0 session-broker access {disabled|viewer|full-attach}" >&2; return 1 ;;
  esac
  eff="$(_cbox_sshd_target_effdir)" || return 1
  mkdir -p -m 0700 "$eff/sshd-access"
  chmod 0700 "$eff/sshd-access"
  local tmp
  tmp="$(mktemp "$eff/sshd-access/.cbox.XXXXXX")"
  printf '%s\n' "$level" > "$tmp"
  chmod 0600 "$tmp"
  mv -f "$tmp" "$eff/sshd-access/level"
  echo "cbox: sshd access level set to '$level' - takes effect on the next connection (read fresh by the entry program every time, never cached)"
}

_cbox_session_broker_window_cmd() {
  local spec="${1:-}" eff tmp deadline
  [ -n "$spec" ] || { echo "cbox: usage: $0 session-broker window {off|<minutes>}" >&2; return 1; }
  eff="$(_cbox_sshd_target_effdir)" || return 1
  mkdir -p -m 0700 "$eff/sshd-access"
  chmod 0700 "$eff/sshd-access"
  tmp="$(mktemp "$eff/sshd-access/.cbox.XXXXXX")"
  if [ "$spec" = off ]; then
    : > "$tmp"
    chmod 0600 "$tmp"
    mv -f "$tmp" "$eff/sshd-access/window"
    echo "cbox: sshd access window cleared - open indefinitely (still gated by the access level)"
    return 0
  fi
  case "$spec" in
    ''|*[!0-9]*) echo "cbox: usage: $0 session-broker window {off|<minutes>}" >&2; return 1 ;;
  esac
  deadline=$(( $(date +%s) + spec * 60 ))
  printf '%s\n' "$deadline" > "$tmp"
  chmod 0600 "$tmp"
  mv -f "$tmp" "$eff/sshd-access/window"
  echo "cbox: sshd access window open for $spec minute(s) (closes $(date -d "@$deadline" 2>/dev/null || date -r "$deadline" 2>/dev/null))"
}

_cbox_session_broker_key_add_cmd() {
  local keyfile="${1:-}" comment="${2:-}" eff line pubkey
  [ -n "$keyfile" ] || { echo "cbox: usage: $0 session-broker key add <pubkey-file> [comment]" >&2; return 1; }
  [ -f "$keyfile" ] || { echo "cbox: $keyfile: no such file" >&2; return 1; }
  line="$(head -n1 "$keyfile")"
  case "$line" in
    ssh-ed25519\ *|ssh-rsa\ *|ecdsa-sha2-*\ *) ;;
    *) echo "cbox: $keyfile does not look like a public key (first line must start with ssh-ed25519, ssh-rsa or ecdsa-sha2-*)" >&2; return 1 ;;
  esac
  pubkey="$(ssh-keygen -lf "$keyfile" 2>/dev/null)" || { echo "cbox: $keyfile does not parse as a public key (ssh-keygen -lf failed)" >&2; return 1; }
  eff="$(_cbox_sshd_target_effdir)" || return 1
  [ -f "$eff/sshd-authorized_keys" ] || { echo "cbox: $eff/sshd-authorized_keys does not exist yet - run 'cbox up' or 'cbox run' once first to render it" >&2; return 1; }
  local keytype keyblob existing
  keytype="$(printf '%s' "$line" | awk '{print $1}')"
  keyblob="$(printf '%s' "$line" | awk '{print $2}')"
  while IFS= read -r existing; do
    [ -n "$existing" ] || continue
    case "$existing" in
      *"$keytype $keyblob"*) echo "cbox: this key is already present in $eff/sshd-authorized_keys" >&2; return 1 ;;
    esac
  done < "$eff/sshd-authorized_keys"
  local tmp entry
  if [ -n "$comment" ]; then
    entry="restrict,pty $keytype $keyblob $comment"
  else
    entry="restrict,pty $keytype $keyblob"
  fi
  tmp="$(mktemp "$eff/.cbox.authorized_keys.XXXXXX")"
  cat "$eff/sshd-authorized_keys" > "$tmp"
  printf '%s\n' "$entry" >> "$tmp"
  chmod 0600 "$tmp"
  mv -f "$tmp" "$eff/sshd-authorized_keys"
  echo "cbox: key added ($pubkey)"
}

_cbox_session_broker_key_rm_cmd() {
  local fp="${1:-}" eff
  [ -n "$fp" ] || { echo "cbox: usage: $0 session-broker key rm <fingerprint>" >&2; return 1; }
  eff="$(_cbox_sshd_target_effdir)" || return 1
  [ -s "$eff/sshd-authorized_keys" ] || { echo "cbox: $eff/sshd-authorized_keys is empty - nothing to remove" >&2; return 1; }
  local tmp line removed=0
  tmp="$(mktemp "$eff/.cbox.authorized_keys.XXXXXX")"
  : > "$tmp"
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    local this_fp
    this_fp="$(printf '%s\n' "$line" | ssh-keygen -lf /dev/stdin 2>/dev/null | awk '{print $2}')"
    if [ "$this_fp" = "$fp" ]; then
      removed=1
      continue
    fi
    printf '%s\n' "$line" >> "$tmp"
  done < "$eff/sshd-authorized_keys"
  if [ "$removed" != 1 ]; then
    rm -f "$tmp"
    echo "cbox: no key with fingerprint $fp found in $eff/sshd-authorized_keys" >&2
    return 1
  fi
  chmod 0600 "$tmp"
  mv -f "$tmp" "$eff/sshd-authorized_keys"
  echo "cbox: key $fp removed"
}

_cbox_session_broker_key_fingerprints_cmd() {
  local eff line fp comment found=0
  eff="$(_cbox_sshd_target_effdir)" || return 1
  if [ ! -s "$eff/sshd-authorized_keys" ]; then
    echo "cbox: no keys trusted - $eff/sshd-authorized_keys is empty"
    return 0
  fi
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    found=1
    fp="$(printf '%s\n' "$line" | ssh-keygen -lf /dev/stdin 2>/dev/null)"
    if [ -z "$fp" ]; then
      echo "cbox: (unparseable line in $eff/sshd-authorized_keys)"
      continue
    fi
    echo "$fp"
  done < "$eff/sshd-authorized_keys"
  [ "$found" = 1 ] || echo "cbox: no keys trusted"
  return 0
}

_cbox_session_broker_key_cmd() {
  local sub="${1:-}"
  shift || true
  case "$sub" in
    add) _cbox_session_broker_key_add_cmd "$@" ;;
    rm) _cbox_session_broker_key_rm_cmd "$@" ;;
    fingerprints) _cbox_session_broker_key_fingerprints_cmd "$@" ;;
    *)
      echo "cbox: usage: $0 session-broker key {add <pubkey-file> [comment]|rm <fingerprint>|fingerprints}" >&2
      return 1
      ;;
  esac
}

session_broker_cmd() {
  local sub="${1:-}"
  case "$sub" in
    status|access|window|key) ;;
    *)
      echo "cbox: usage: $0 session-broker {status|access {disabled|viewer|full-attach}|window {off|<minutes>}|key {add <pubkey-file> [comment]|rm <fingerprint>|fingerprints}}" >&2
      return 1
      ;;
  esac
  shift
  if _cbox_config_in_container; then
    echo "cbox: session-broker $sub is host-only - it writes the access files this container's sshd entry program reads" >&2
    return 1
  fi
  [ -f "$INSTALL_DIR/templates/sections.sh" ] || die "$INSTALL_DIR/templates/sections.sh missing"
  . "$INSTALL_DIR/templates/sections.sh"
  case "$sub" in
    status) _cbox_session_broker_status_cmd ;;
    access) _cbox_session_broker_access_cmd "$@" ;;
    window) _cbox_session_broker_window_cmd "$@" ;;
    key) _cbox_session_broker_key_cmd "$@" ;;
  esac
}

_run_global() {
  local bin="$1"; shift
  local workspaces=() w root inscope=0
  read -r -a workspaces <<< "${CBOX_WORKSPACES:-}"
  root="$(_cbox_realpath "$PWD" 2>/dev/null || printf '%s' "$PWD")"
  for w in "${workspaces[@]}"; do
    [ -n "$w" ] || continue
    case "$root" in
      "$w"|"$w"/*) inscope=1; break ;;
    esac
  done
  if [ "${#workspaces[@]}" -gt 0 ] && [ "$inscope" != 1 ]; then
    if [ -t 0 ] && [ -t 1 ]; then
      local ans
      printf 'cbox: global container does not mount this folder - switch to an isolated per-project container? [y/N] '
      read -r ans
      case "$ans" in
        y|Y)
          _run_isolated "$bin" "$@"
          return
          ;;
        *)
          echo "cbox: cancelled" >&2
          return 1
          ;;
      esac
    else
      echo "cbox: global container does not mount $PWD and no TTY to confirm switching to isolated mode" >&2
      return 1
    fi
  fi
  check_tpl_sha
  _cbox_global_prepare_locked
  _cbox_compose_refresh_gpu
  _gc_bg
  _bins_soft "$IMG_TAG"
  if _cbox_proxy_active; then "${COMPOSE[@]}" build >/dev/null; fi
  _clip_bridge_start "$(_cbox_clip_dir "${CBOX_NAME:-cbox}")"
  local workspace_scope
  workspace_scope="$(_cbox_workspace_root 2>/dev/null)" || workspace_scope="$root"
  _container_exec_bridge_start "$(_cbox_container_exec_dir "${CBOX_NAME:-cbox}")" "$workspace_scope" global || {
    _clip_bridge_stop
    return 1
  }
  _cbox_compose_up "$HOME/.config/cbox/compose.up.stamp" "${COMPOSE[@]}" >/dev/null || {
    _container_exec_bridge_stop
    _clip_bridge_stop
    return 1
  }
  _cbox_netaccess_apply_global || {
    _container_exec_bridge_stop
    _clip_bridge_stop
    return 1
  }
  _cbox_probe_exes_seed "$INSTALL_DIR" "$("${COMPOSE[@]}" ps -q "$SERVICE" 2>/dev/null | head -n1)"
  _cbox_netaccess_socks_exec_env
  local workdir="$CBOX_WORKDIR"
  for w in "${workspaces[@]}"; do
    case "$root" in
      "$w"|"$w"/*) workdir="$root" ;;
    esac
  done
  if [ -t 0 ] && [ -t 1 ]; then
    exec "${COMPOSE[@]}" exec -it "${CBOX_CONTAINER_EXEC_ENV[@]}" "${CBOX_SOCKS_EXEC_ENV[@]}" -w "$workdir" "$SERVICE" /entrypoint.sh "$bin" "$@"
  else
    exec "${COMPOSE[@]}" exec -T "${CBOX_CONTAINER_EXEC_ENV[@]}" "${CBOX_SOCKS_EXEC_ENV[@]}" -w "$workdir" "$SERVICE" /entrypoint.sh "$bin" "$@"
  fi
}

_first_run_init() {
  local root="$1" eff="$2" ans rc
  if ! { [ -t 0 ] && [ -t 1 ]; }; then
    echo "cbox: no effective config for $root and no TTY - run 'cbox run codex' interactively or 'cbox setup --local $root' first" >&2
    return 1
  fi
  mkdir -p "$HOME/.config/cbox/projects"
  exec 7> "$HOME/.config/cbox/projects/.init.lock"
  _cbox_flock -w 60 7 || { echo "cbox: another init is running" >&2; exec 7>&-; return 1; }
  if [ -f "$eff/cbox.conf" ]; then
    exec 7>&-
    return 0
  fi
  printf 'cbox: new project %s\n  [n] configure from scratch\n  [d] derive from global config\n  [z] cancel\n> ' "$root"
  read -r ans
  rc=0
  case "$ans" in
    n) "$INSTALL_DIR/cbox" setup --local "$root" || rc=$? ;;
    d) "$INSTALL_DIR/cbox" setup --local "$root" --from-global || rc=$? ;;
    *) echo "cbox: cancelled" >&2; exec 7>&-; return 1 ;;
  esac
  exec 7>&-
  [ "$rc" -eq 0 ] && [ -f "$eff/cbox.conf" ]
}

_gen_effective() {
  local eff="$1" root="$2" digest
  gen_managed_settings
  digest="$(_cbox_resolve_base_digest ubuntu:24.04)" || die "cannot resolve base image digest and no local image - network required for first build"
  cp "$INSTALL_DIR/entrypoint.sh" "$eff/entrypoint.sh"
  cp "$INSTALL_DIR/install-bins.sh" "$eff/install-bins.sh"
  cp "$INSTALL_DIR/.dockerignore" "$eff/.dockerignore"
  gen_session_entry_into "$eff"
  gen_image_inputs "$eff" "$digest"
  IMG_HASH="$(_cbox_image_hash "$eff")"
  IMG_TAG="$(_cbox_image_tag "$IMG_HASH")"
  gen_dockerfile_into "$eff" "$digest"
  gen_env_file_into "$eff"
  gen_compose_isolated "$eff" "$root" "$IMG_TAG" "$IMG_HASH"
  gen_compose_readonly_into "$eff/docker-compose.readonly.yml" "$root"
  gen_codex_profile_into "$eff/codex" isolated "$root"
  gen_codex_agents_into "$eff/codex"
  gen_codex_hooks_json_into "$eff/codex"
  if [ "${CBOX_HERMES:-off}" = on ]; then
    gen_hermes_managed_into "$eff/hermes/managed.env"
    gen_hermes_mcp_servers_into "$eff/hermes/mcp_servers.yaml"
    if [ "${CBOX_HERMES_HOOKS:-off}" = on ]; then
      gen_hermes_hooks_into "$eff/hermes/hooks.yaml"
    else
      rm -f "$eff/hermes/hooks.yaml"
    fi
  else
    rm -f "$eff/hermes/managed.env"
    rm -f "$eff/hermes/mcp_servers.yaml"
    rm -f "$eff/hermes/hooks.yaml"
  fi
}

_ensure_image() {
  local eff="$1" img_hash img_tag base
  img_hash="$(_cbox_image_hash "$eff")"
  img_tag="$(_cbox_image_tag "$img_hash")"
  IMG_HASH="$img_hash"
  IMG_TAG="$img_tag"
  docker image inspect "$img_tag" >/dev/null 2>&1 && return 0
  echo "cbox: building $img_tag (inputs changed or first build)" >&2
  base="$(_cbox_manifest_field "$eff/image.inputs" base 2>/dev/null || true)"
  docker build -t "$img_tag" \
    --label "cbox.inputs=$img_hash" \
    --label "cbox.base=$base" \
    -f "$eff/Dockerfile" "$eff"
}

_bins_cache_file() {
  printf '%s/.config/cbox/bins.stamp' "$HOME"
}

_bins_lock_file() {
  printf '%s/.config/cbox/bins.lock' "$HOME"
}

_bins_want() {
  local tool="$1"
  case "$tool" in
    claude) printf '%s' "${CBOX_CLAUDE_TARGET:-stable}" ;;
    codex) printf '%s' "${CBOX_CODEX_VERSION:-latest}" ;;
    hermes) printf '%s' "${CBOX_HERMES_VERSION:-latest}" ;;
  esac
}

_bins_hermes_on() {
  [ "${CBOX_HERMES:-off}" = on ]
}

_bins_cache_get() {
  local volume="$1" cache line
  cache="$(_bins_cache_file)"
  [ -f "$cache" ] || return 1
  line="$(grep -F "$volume|" "$cache" 2>/dev/null | tail -n1)" || true
  [ -n "$line" ] || return 1
  printf '%s' "$line"
}

_bins_cache_put() {
  local volume="$1" tool="$2" want="$3" version="$4" cache dir tmp
  cache="$(_bins_cache_file)"
  dir="$(dirname "$cache")"
  mkdir -p "$dir"
  tmp="$(mktemp "$dir/.cbox.XXXXXX")"
  {
    if [ -f "$cache" ]; then
      grep -Fv "$volume|" "$cache" 2>/dev/null || true
    fi
    printf '%s|%s|%s|%s|%s\n' "$volume" "$tool" "$want" "$version" "$(date +%s)"
  } > "$tmp"
  mv "$tmp" "$cache"
}

_bins_cache_field() {
  local line="$1" field="$2"
  printf '%s' "$line" | awk -F'|' -v f="$field" '{
    n = NF
    if (f == "volume") { print $1; next }
    if (f == "tool") { print $2; next }
    if (f == "version") { print $(n - 1); next }
    if (f == "epoch") { print $n; next }
    if (f == "want") {
      out = $3
      for (i = 4; i <= n - 2; i++) out = out "|" $i
      print out
      next
    }
  }'
}

_bins_stale() {
  local volume="$1" tool="$2" want="$3" line cur_tool cur_want
  docker volume inspect "$volume" >/dev/null 2>&1 || return 0
  line="$(_bins_cache_get "$volume")" || return 0
  cur_tool="$(_bins_cache_field "$line" tool)"
  cur_want="$(_bins_cache_field "$line" want)"
  [ "$cur_tool" = "$tool" ] || return 0
  [ "$cur_want" = "$want" ] || return 0
  return 1
}

_bins_run_install() {
  local img_tag="$1" tools="$2" force="$3" rc=0 tool
  local vendor="" hermes=""
  for tool in $tools; do
    case "$tool" in
      hermes) hermes="hermes" ;;
      *) vendor="${vendor:+$vendor }$tool" ;;
    esac
  done
  [ -z "$vendor" ] || _bins_run_install_group "$img_tag" "$vendor" "$force" || rc=1
  [ -z "$hermes" ] || _bins_run_install_group "$img_tag" "$hermes" "$force" || rc=1
  return "$rc"
}

_bins_run_install_group() {
  local img_tag="$1" tools="$2" force="$3" claude_vol codex_vol hermes_vol rc line name version hash status status_word
  local -a mounts=()
  case " $tools " in
    *" hermes "*)
      hermes_vol="$(_cbox_bins_volume hermes)"
      docker volume create "$hermes_vol" >/dev/null
      mounts+=(-v "$hermes_vol:/opt/hermes:rw")
      ;;
    *)
      claude_vol="$(_cbox_bins_volume claude)"
      codex_vol="$(_cbox_bins_volume codex)"
      docker volume create "$claude_vol" >/dev/null
      docker volume create "$codex_vol" >/dev/null
      mounts+=(-v "$claude_vol:$HOME/.local:rw" -v "$codex_vol:$HOME/.codex/packages:rw")
      ;;
  esac
  rc=0
  status="$(docker run --rm \
    "${mounts[@]}" \
    -e HOST_USER="$(id -un)" \
    -e HOST_UID="$(id -u)" \
    -e HOST_GID="$(id -g)" \
    -e HOST_HOME="$HOME" \
    -e CBOX_CLAUDE_TARGET="${CBOX_CLAUDE_TARGET:-stable}" \
    -e CBOX_CODEX_VERSION="${CBOX_CODEX_VERSION:-latest}" \
    -e CBOX_CODEX_TARGET="${CBOX_CODEX_TARGET:-}" \
    -e CBOX_HERMES_VERSION="${CBOX_HERMES_VERSION:-latest}" \
    -e CBOX_INSTALL_TOOLS="$tools" \
    -e CBOX_INSTALL_FORCE="$force" \
    --entrypoint /opt/cbox/install-bins.sh \
    "$img_tag")" || rc=$?
  printf '%s\n' "$status" | while IFS= read -r line; do
    case "$line" in
      ""|cbox-bins:*) ;;
      *) echo "$line" >&2 ;;
    esac
  done
  while IFS= read -r line; do
    case "$line" in
      cbox-bins:*)
        name="$(printf '%s' "$line" | awk '{print $2}')"
        version="$(printf '%s' "$line" | awk '{print $3}')"
        hash="$(printf '%s' "$line" | awk '{print $4}')"
        status_word="$(printf '%s' "$line" | awk '{print $5}')"
        case "$status_word" in
          refuse|fail)
            echo "cbox: bins install refused for $name (see message above) - re-pin the project, run '$0 reinstall-bins --force' to move the shared tuple, or set CBOX_BINS_SCOPE=pinned for a private volume" >&2
            rc=1
            ;;
          ok|adopt)
            _bins_cache_put "$(_cbox_bins_volume "$name")" "$name" "$(_bins_want "$name")" "$version"
            ;;
        esac
        ;;
    esac
  done <<< "$status"
  return "$rc"
}

_ensure_bins() {
  local img_tag="$1" force="${2:-0}" lock claude_vol codex_vol hermes_vol
  local -a stale_tools=()
  claude_vol="$(_cbox_bins_volume claude)"
  codex_vol="$(_cbox_bins_volume codex)"
  hermes_vol="$(_cbox_bins_volume hermes)"
  if [ "$force" != 1 ]; then
    _bins_stale "$claude_vol" claude "$(_bins_want claude)" && stale_tools+=(claude)
    _bins_stale "$codex_vol" codex "$(_bins_want codex)" && stale_tools+=(codex)
    _bins_hermes_on && _bins_stale "$hermes_vol" hermes "$(_bins_want hermes)" && stale_tools+=(hermes)
    [ "${#stale_tools[@]}" -eq 0 ] && return 0
  else
    stale_tools=(claude codex)
    _bins_hermes_on && stale_tools+=(hermes)
  fi
  lock="$(_bins_lock_file)"
  mkdir -p "$(dirname "$lock")"
  exec 6> "$lock"
  _cbox_flock -w 900 6 || { echo "cbox: timed out waiting for another bins install to finish" >&2; exec 6>&-; return 1; }
  if [ "$force" != 1 ]; then
    stale_tools=()
    _bins_stale "$claude_vol" claude "$(_bins_want claude)" && stale_tools+=(claude)
    _bins_stale "$codex_vol" codex "$(_bins_want codex)" && stale_tools+=(codex)
    _bins_hermes_on && _bins_stale "$hermes_vol" hermes "$(_bins_want hermes)" && stale_tools+=(hermes)
    if [ "${#stale_tools[@]}" -eq 0 ]; then
      exec 6>&-
      return 0
    fi
  fi
  echo "cbox: installing/updating binaries (${stale_tools[*]}) into shared volumes" >&2
  local rc=0
  _bins_run_install "$img_tag" "${stale_tools[*]}" "$force" || rc=$?
  exec 6>&-
  return "$rc"
}

_bins_soft() {
  _ensure_bins "$@" || echo "cbox: warning: bins install failed - continuing; affected tools stay unavailable until you fix the pin or network and run '$0 reinstall-bins'" >&2
  _bins_autoupdate_bg "$1"
  return 0
}

_bins_channel() {
  case "$1" in
    claude)
      case "${CBOX_CLAUDE_TARGET:-stable}" in stable|latest) return 0 ;; esac
      ;;
    codex)
      case "${CBOX_CODEX_VERSION:-latest}" in latest) return 0 ;; esac
      ;;
    hermes)
      _bins_hermes_on || return 1
      case "${CBOX_HERMES_VERSION:-latest}" in latest) return 0 ;; esac
      ;;
  esac
  return 1
}

_engine_autoupdate_off() {
  case "$1" in
    claude)
      grep -Eqs '"autoUpdates"[[:space:]]*:[[:space:]]*false' "$HOME/.claude/settings.json"
      ;;
    codex)
      grep -Eqs '^[[:space:]]*check_for_update_on_startup[[:space:]]*=[[:space:]]*false' "$HOME/.codex/config.toml"
      ;;
    *)
      return 1
      ;;
  esac
}

_bins_autoupdate() {
  local img_tag="$1" ttl_h="${CBOX_AUTOUPDATE_TTL_HOURS:-24}" tool stampdir stampf last now lock
  case "$ttl_h" in ''|*[!0-9]*) ttl_h=24 ;; esac
  stampdir="$HOME/.config/cbox"
  now="$(date +%s)"
  local -a due=()
  for tool in claude codex hermes; do
    _bins_channel "$tool" || continue
    _engine_autoupdate_off "$tool" && continue
    stampf="$stampdir/autoupdate.$(_cbox_bins_volume "$tool").stamp"
    last="$(cat "$stampf" 2>/dev/null || echo 0)"
    case "$last" in ''|*[!0-9]*) last=0 ;; esac
    [ "$last" -gt "$now" ] && last=0
    [ $((now - last)) -ge $((ttl_h * 3600)) ] && due+=("$tool")
  done
  [ "${#due[@]}" -gt 0 ] || return 0
  lock="$(_bins_lock_file)"
  mkdir -p "$stampdir"
  exec 5> "$lock"
  _cbox_flock -n 5 || { exec 5>&-; return 0; }
  for tool in "${due[@]}"; do
    printf '%s\n' "$now" > "$stampdir/autoupdate.$(_cbox_bins_volume "$tool").stamp"
  done
  echo "cbox: autoupdate: refreshing channel bins (${due[*]}) at $(date -u '+%Y-%m-%dT%H:%M:%SZ')"
  _bins_run_install "$img_tag" "${due[*]}" refresh || echo "cbox: autoupdate: install failed; next attempt after TTL"
  exec 5>&-
}

_bins_autoupdate_bg() {
  [ "${CBOX_AUTOUPDATE:-on}" = on ] || return 0
  local img_tag="$1" log="$HOME/.config/cbox/autoupdate.log"
  mkdir -p "$HOME/.config/cbox"
  ( _bins_autoupdate "$img_tag" >> "$log" 2>&1 ) </dev/null >/dev/null 2>&1 &
  disown 2>/dev/null || true
}

_bins_conflict_scan() {
  local tool="$1" want="$2" proj conf p_want p_scope hits=""
  for proj in "$HOME"/.config/cbox/projects/*/; do
    [ -d "$proj" ] || continue
    conf="$proj/cbox.conf"
    [ -f "$conf" ] || continue
    p_want="$(unset CBOX_CLAUDE_TARGET CBOX_CODEX_VERSION CBOX_CODEX_TARGET CBOX_HERMES_VERSION CBOX_BINS_SCOPE; source "$conf" 2>/dev/null; _bins_want "$tool")"
    p_scope="$(unset CBOX_BINS_SCOPE; source "$conf" 2>/dev/null; printf '%s' "${CBOX_BINS_SCOPE:-global}")"
    [ "$p_scope" = "global" ] || continue
    if [ "$p_want" != "$want" ]; then
      hits="$hits $(basename "$proj")"
    fi
  done
  printf '%s' "${hits# }"
}

_bins_conflict_report() {
  [ "${CBOX_BINS_SCOPE:-global}" = global ] || return 0
  local hits_claude hits_codex hits_hermes
  hits_claude="$(_bins_conflict_scan claude "$(_bins_want claude)")"
  hits_codex="$(_bins_conflict_scan codex "$(_bins_want codex)")"
  [ -z "$hits_claude" ] || echo "cbox: moving the shared claude tuple will make these projects mismatch:$hits_claude" >&2
  [ -z "$hits_codex" ] || echo "cbox: moving the shared codex tuple will make these projects mismatch:$hits_codex" >&2
  if _bins_hermes_on; then
    hits_hermes="$(_bins_conflict_scan hermes "$(_bins_want hermes)")"
    [ -z "$hits_hermes" ] || echo "cbox: moving the shared hermes tuple will make these projects mismatch:$hits_hermes" >&2
  fi
}

reinstall_bins() {
  local fresh=0 if_stale=0 force=0
  case "${1:-}" in
    --fresh) fresh=1; shift ;;
    --if-stale) if_stale=1; shift ;;
    --force) force=1; shift ;;
  esac
  local mode img_tag
  [ "$force" != 1 ] || echo "cbox: --force - forcing bins reinstall of the configured tuple" >&2
  case "${CBOX_INSTALL_FORCE:-0}" in
    1)
      if [ "$if_stale" = 1 ]; then
        echo "cbox: ignoring CBOX_INSTALL_FORCE=1 - --if-stale runs without force" >&2
      elif [ "$force" != 1 ]; then
        force=1
        echo "cbox: CBOX_INSTALL_FORCE=1 - forcing bins reinstall (moves the shared tuple)" >&2
      fi
      ;;
  esac
  mode="$(_cbox_effective_mode)"
  case "$mode" in
    isolated)
      local root eff
      root="$(_cbox_workspace_root)" || die "refusing to run in $PWD (home, /, or a mount root)"
      eff="$HOME/.config/cbox/projects/$(_cbox_path_hash "$root")"
      [ -f "$eff/cbox.conf" ] || die "no effective config for $root - run 'cbox run codex' or 'cbox setup --local $root' first"
      (
        set -e
        unset CBOX_MODE CBOX_SESSION_SCOPE CBOX_BASE_DIGEST_TTL CBOX_CODEX_TARGET CBOX_BINS_SCOPE
        . "$eff/cbox.conf"
        img_tag="$(_cbox_image_tag "$(_cbox_image_hash "$eff")")"
        docker image inspect "$img_tag" >/dev/null 2>&1 || die "image $img_tag not built - run 'cbox run codex' first"
        if [ "$if_stale" = 1 ]; then
          _ensure_bins "$img_tag" 0
        else
          if [ "$fresh" = 1 ]; then
            force=1
            docker volume rm "$(_cbox_bins_volume claude)" >/dev/null 2>&1 || true
            docker volume rm "$(_cbox_bins_volume codex)" >/dev/null 2>&1 || true
            ! _bins_hermes_on || docker volume rm "$(_cbox_bins_volume hermes)" >/dev/null 2>&1 || true
          else
            _bins_conflict_report
          fi
          _ensure_bins "$img_tag" "$force"
        fi
      )
      _cbox_probe_exes_seed "$eff" "" 1
      ;;
    global)
      require_global_conf
      [ -f "$INSTALL_DIR/image.inputs" ] || die "global image inputs missing - run 'cbox up' first"
      img_tag="$(_cbox_image_tag "$(_cbox_image_hash "$INSTALL_DIR")")"
      docker image inspect "$img_tag" >/dev/null 2>&1 || die "image $img_tag not built - run 'cbox up' first"
      if [ "$if_stale" = 1 ]; then
        _ensure_bins "$img_tag" 0
        return
      fi
      if [ "$fresh" = 1 ]; then
        force=1
        docker volume rm "$(_cbox_bins_volume claude)" >/dev/null 2>&1 || true
        docker volume rm "$(_cbox_bins_volume codex)" >/dev/null 2>&1 || true
        ! _bins_hermes_on || docker volume rm "$(_cbox_bins_volume hermes)" >/dev/null 2>&1 || true
      else
        _bins_conflict_report
      fi
      _ensure_bins "$img_tag" "$force"
      _cbox_probe_exes_seed "$INSTALL_DIR" "" 1
      ;;
    *)
      die_no_conf
      ;;
  esac
}

_ensure_volumes() {
  local eff="$1" p_hash
  p_hash="$(_cbox_path_hash "$(cat "$eff/workspace")")"
  if [ "${CBOX_CLAUDE_MODE:-mount}" = volume ]; then
    docker volume create "cbox-p${p_hash}-claude" >/dev/null
  fi
  if [ "${CBOX_CODEX_MODE:-mount}" = volume ]; then
    docker volume create "cbox-p${p_hash}-codex" >/dev/null
  fi
  if [ "${CBOX_VENV_MODE:-none}" = volume ]; then
    docker volume create "cbox-p${p_hash}-venv" >/dev/null
  fi
  case "${CBOX_SSH_MODE:-none}" in
    container-keys|mixed) docker volume create "cbox-p${p_hash}-ssh" >/dev/null ;;
  esac
}

_mirror_write_one() {
  local dir="$1" src="$2" name="$3" tmp
  [ -f "$src" ] || return 0
  tmp="$(mktemp "$dir/.cbox.XXXXXX")" || return 0
  if cp "$src" "$tmp" 2>/dev/null; then
    chmod 0644 "$tmp"
    mv "$tmp" "$dir/$name" 2>/dev/null || rm -f "$tmp"
  else
    rm -f "$tmp"
  fi
}

_write_mirror() {
  local root="$1" eff="$2" dir tmp
  dir="$root/.cbox/runtime"
  if [ -L "$root/.cbox" ] || [ -L "$dir" ]; then
    echo "cbox: warning: $dir is a symlink - skipping mirror" >&2
    return 0
  fi
  mkdir -p "$dir" 2>/dev/null || { echo "cbox: warning: cannot create $dir - skipping mirror" >&2; return 0; }
  case "$(_cbox_realpath "$dir" 2>/dev/null)" in
    "$root"/*) ;;
    *) echo "cbox: warning: $dir escapes workspace - skipping mirror" >&2; return 0 ;;
  esac
  _mirror_write_one "$dir" "$eff/docker-compose.yml" docker-compose.mirror.yml
  _mirror_write_one "$dir" "$eff/cbox.conf" cbox.conf.mirror
  _mirror_write_one "$dir" "$eff/Dockerfile" Dockerfile.mirror
  _mirror_write_one "$dir" "$eff/image.inputs" image-inputs.mirror
  tmp="$(mktemp "$dir/.cbox.XXXXXX")"
  if [ -n "$tmp" ]; then
    printf '*\n' > "$tmp"
    mv "$tmp" "$dir/.gitignore" 2>/dev/null || rm -f "$tmp"
  fi
  tmp="$(mktemp "$dir/.cbox.XXXXXX")"
  if [ -n "$tmp" ]; then
    {
      printf 'mirror of %s\n' "$eff"
      printf 'not authoritative; edits here have no effect and are overwritten\n'
      printf 'add .cbox/runtime/ (never .cbox/) to your repo .gitignore if you want it untracked there too\n'
    } > "$tmp"
    mv "$tmp" "$dir/README" 2>/dev/null || rm -f "$tmp"
  fi
}

_CBOX_PROBE_SH='
cp="${CBOX_PROBE_CP:-}"
xp="${CBOX_PROBE_XP:-}"
n=0
for p in /proc/[0-9]*/exe; do
  e="$(readlink "$p" 2>/dev/null)" || continue
  e="${e% (deleted)}"
  d="${p%/exe}/cmdline"
  if [ -n "$cp" ] && [ "$e" = "$cp" ]; then
    [ -e "$d" ] || continue
    a1="$(tr "\0" "\n" < "$d" 2>/dev/null | sed -n 2p)"
    case "$a1" in daemon|--bg-pty-host|--bg-spare) continue ;; esac
    n=$((n+1)); continue
  fi
  if [ -n "$xp" ] && [ "$e" = "$xp" ]; then
    [ -e "$d" ] || continue
    a1="$(tr "\0" "\n" < "$d" 2>/dev/null | sed -n 2p)"
    case "$a1" in mcp-server) continue ;; esac
    n=$((n+1)); continue
  fi
  case "$e" in
    /usr/bin/python3*|/opt/hermes/bin/python3*)
      [ -e "$d" ] || continue
      a0="$(tr "\0" "\n" < "$d" 2>/dev/null | sed -n 1p)"
      case "$a0" in
        /opt/hermes/bin/*)
          a1="$(tr "\0" "\n" < "$d" 2>/dev/null | sed -n 2p)"
          case "$a1" in
            /opt/hermes/bin/hermes|/usr/local/bin/hermes) n=$((n+1)) ;;
          esac
          ;;
      esac
      ;;
  esac
done
printf %s "$n"
'

_cbox_probe_exes_file() {
  local eff="$1"
  [ -n "$eff" ] || return 1
  printf '%s/probe-exes' "$eff"
}

_cbox_probe_exes_refresh() {
  local eff="$1" cid="$2" f cp xp cp_rc xp_rc tmp
  f="$(_cbox_probe_exes_file "$eff")" || return 1
  cp="$(docker exec "$cid" sh -c 'sed -n 2p "$HOME/.local/.cbox-stamp" 2>/dev/null' 2>/dev/null)"; cp_rc=$?
  xp="$(docker exec "$cid" sh -c 'sed -n 2p "$HOME/.codex/packages/.cbox-stamp" 2>/dev/null' 2>/dev/null)"; xp_rc=$?
  if [ "$cp_rc" -ne 0 ] || [ "$xp_rc" -ne 0 ]; then
    return 1
  fi
  case "$cp" in *$'\n'*) cp="" ;; esac
  case "$xp" in *$'\n'*) xp="" ;; esac
  if [ -z "$cp" ] && [ -z "$xp" ]; then
    return 1
  fi
  tmp="$f.tmp.$$"
  printf '%s\n%s\n' "$cp" "$xp" > "$tmp" 2>/dev/null || { rm -f "$tmp" 2>/dev/null; return 1; }
  mv "$tmp" "$f" 2>/dev/null || { rm -f "$tmp" 2>/dev/null; return 1; }
  return 0
}

_cbox_probe_exes_seed() {
  local eff="$1" cid="${2:-}" force="${3:-0}" f
  [ -n "$eff" ] || return 0
  if [ "$force" != 1 ]; then
    f="$(_cbox_probe_exes_file "$eff" 2>/dev/null)" || f=""
    [ -n "$f" ] && [ -f "$f" ] && return 0
  fi
  if [ -z "$cid" ]; then
    cid="$(_compose_p "$eff" ps -q cbox 2>/dev/null)" || cid=""
  fi
  [ -n "$cid" ] || return 0
  _cbox_probe_exes_refresh "$eff" "$cid" || true
}

_probe() {
  local cid="$1" eff="${2:-}" f cp xp
  f="$(_cbox_probe_exes_file "$eff" 2>/dev/null)" || f=""
  if [ -z "$f" ] || [ ! -f "$f" ]; then
    printf 'unknown'
    return 0
  fi
  cp="$(sed -n 1p "$f" 2>/dev/null)"
  xp="$(sed -n 2p "$f" 2>/dev/null)"
  if [ -z "$cp" ] && [ -z "$xp" ]; then
    printf 'unknown'
    return 0
  fi
  docker exec -e CBOX_PROBE_CP="$cp" -e CBOX_PROBE_XP="$xp" "$cid" sh -c "$_CBOX_PROBE_SH"
}

_reap() {
  local eff="$1" cid n
  exec 9> "$eff/session.lock"
  if ! _cbox_flock -n -x 9; then
    exec 9>&-
    return 0
  fi
  cid="$(_compose_p "$eff" ps -q cbox 2>/dev/null)" || cid=""
  if [ -z "$cid" ]; then
    exec 9>&-
    return 0
  fi
  n="$(_probe "$cid" "$eff" 2>/dev/null)" || n=unknown
  case "$n" in ''|*[!0-9]*) n=unknown ;; esac
  if [ "$n" = unknown ]; then
    sleep 1
    n="$(_probe "$cid" "$eff" 2>/dev/null)" || n=unknown
    case "$n" in ''|*[!0-9]*) n=unknown ;; esac
  fi
  if [ "$n" = unknown ]; then
    echo "cbox: probe failed for ${cid:0:12}; container left up, cbox gc will retry" >&2
  elif [ "$n" = 0 ]; then
    _compose_p "$eff" down --remove-orphans >/dev/null 2>&1 || true
  fi
  exec 9>&-
}

_clip_bridge_start() {
  [ "${CBOX_CLIPBOARD_MODE:-off}" = bridge ] || return 0
  local dir="$1"
  [ -f "$INSTALL_DIR/etc/clipboard/clip_bridge.py" ] || return 0
  local backend=""
  backend="$(python3 "$INSTALL_DIR/etc/clipboard/clip_bridge.py" --probe 2>/dev/null || true)"
  if [ "$backend" != wayland ] && [ "$backend" != x11 ]; then
    echo "cbox: clipboard bridge: no host clipboard backend - install wl-clipboard (Wayland) or xclip (X11) on the host, or run cbox setup section clipboard; image paste stays broken until then" >&2
  fi
  mkdir -p -m 0700 "$dir" 2>/dev/null || true
  python3 "$INSTALL_DIR/etc/clipboard/clip_bridge.py" --sock-dir "$dir" --parent-pid "${BASHPID:-$$}" >/dev/null 2>&1 &
  _CBOX_CLIP_PID=$!
}

_clip_bridge_stop() {
  [ -n "${_CBOX_CLIP_PID:-}" ] || return 0
  kill "$_CBOX_CLIP_PID" 2>/dev/null || true
  _CBOX_CLIP_PID=""
}

_container_exec_bridge_start() {
  local dir="$1" workspace_root="${2:-}" workspace_mode="${3:-isolated}" network token socket_dir audit_dir parent_pid parent_start root
  local -a networks=() workspace_args=() guard_roots=()
  CBOX_CONTAINER_EXEC_ENV=()
  _cbox_netaccess_exec_active || return 0
  [ -f "$INSTALL_DIR/etc/container/docker_exec_bridge.py" ] || return 1
  for network in ${CBOX_NETACCESS_NETWORKS:-}; do
    networks+=("$network")
  done
  [ "${#networks[@]}" -gt 0 ] || return 1
  if [ "${CBOX_NETACCESS_EXEC_WORKSPACE_GUARD:-off}" = on ]; then
    if [ "$workspace_mode" = global ]; then
      read -r -a guard_roots <<< "${CBOX_WORKSPACES:-}"
    else
      [ -n "$workspace_root" ] || workspace_root="$(_cbox_workspace_root 2>/dev/null)" || return 1
      guard_roots=("$workspace_root")
    fi
    [ "${#guard_roots[@]}" -gt 0 ] || return 1
    for root in "${guard_roots[@]}"; do
      root="$(_cbox_realpath "$root" 2>/dev/null)" || return 1
      [ -d "$root" ] && [ "$root" != / ] || return 1
      workspace_args+=(--workspace-root "$root")
    done
  fi
  token="p${BASHPID:-$$}-$(od -An -tx1 -N4 /dev/urandom 2>/dev/null | tr -d ' \n')"
  case "$token" in *-) token="p${BASHPID:-$$}-${RANDOM}${RANDOM}" ;; esac
  socket_dir="$dir/sockets/$token"
  audit_dir="$dir/audit"
  mkdir -p -m 0700 "$socket_dir" "$audit_dir"
  chmod 0700 "$dir" "$dir/sockets" "$socket_dir" "$audit_dir"
  parent_pid="${BASHPID:-$$}"
  if _cbox_is_darwin; then
    parent_start="$(ps -p "$parent_pid" -o lstart= 2>/dev/null)" || return 1
    [ -n "$parent_start" ] || return 1
  else
    parent_start="$(awk '{print $22}' "/proc/$parent_pid/stat" 2>/dev/null)" || return 1
    case "$parent_start" in ''|*[!0-9]*) return 1 ;; esac
  fi
  python3 "$INSTALL_DIR/etc/container/docker_exec_bridge.py" \
    --sock-dir "$socket_dir" \
    --parent-pid "$parent_pid" \
    --parent-start "$parent_start" \
    --audit-path "$audit_dir/$token.jsonl" \
    --timeout "${CBOX_NETACCESS_EXEC_TIMEOUT:-900}" \
    --max-bytes "${CBOX_NETACCESS_EXEC_MAX_BYTES:-10485760}" \
    "${workspace_args[@]}" \
    --networks "${networks[@]}" >/dev/null 2>&1 &
  _CBOX_CONTAINER_EXEC_PID=$!
  _CBOX_CONTAINER_EXEC_SOCKET_HOST_DIR="$socket_dir"
  CBOX_CONTAINER_EXEC_ENV=(-e "CBOX_CONTAINER_EXEC_SOCKET=/run/cbox-container-exec/$token/bridge.sock")
  local i
  for i in {1..20}; do
    [ -S "$socket_dir/bridge.sock" ] && return 0
    kill -0 "$_CBOX_CONTAINER_EXEC_PID" 2>/dev/null || break
    sleep 0.1
  done
  _container_exec_bridge_stop
  CBOX_CONTAINER_EXEC_ENV=()
  echo "cbox: scoped container exec bridge failed to start" >&2
  return 1
}

_container_exec_bridge_stop() {
  [ -n "${_CBOX_CONTAINER_EXEC_PID:-}" ] || return 0
  kill "$_CBOX_CONTAINER_EXEC_PID" 2>/dev/null || true
  wait "$_CBOX_CONTAINER_EXEC_PID" 2>/dev/null || true
  _CBOX_CONTAINER_EXEC_PID=""
  [ -z "${_CBOX_CONTAINER_EXEC_SOCKET_HOST_DIR:-}" ] || rmdir "$_CBOX_CONTAINER_EXEC_SOCKET_HOST_DIR" 2>/dev/null || true
  _CBOX_CONTAINER_EXEC_SOCKET_HOST_DIR=""
  CBOX_CONTAINER_EXEC_ENV=()
}

_session_sig() {
  local sig="$1"
  trap - INT TERM HUP
  exec 8>&- 2>/dev/null || true
  _container_exec_bridge_stop
  _clip_bridge_stop
  _reap "$_CBOX_SESSION_EFF"
  kill -s "$sig" "${BASHPID:-$$}" 2>/dev/null
  exit 1
}

_session_run() {
  local eff="$1" bin="$2"; shift 2
  local rc=0 wd root
  local use_session_env=0
  local -a extra_env=()
  if [ "${1:-}" = "--session-env" ]; then
    shift
    use_session_env=1
  fi
  local pre_hook=""
  if [ "${1:-}" = "--pre-hook" ]; then
    pre_hook="$2"
    shift 2
  fi
  local post_hook=""
  if [ "${1:-}" = "--post-hook" ]; then
    post_hook="$2"
    shift 2
  fi
  if [ "${1:-}" = "--" ]; then
    shift
  fi
  root="$(cat "$eff/workspace" 2>/dev/null || printf '%s' "$PWD")"
  exec 8> "$eff/session.lock"
  _cbox_flock -s 8 || { echo "cbox: cannot lock session for $eff" >&2; exec 8>&-; return 1; }
  _gc_bg
  _CBOX_SESSION_EFF="$eff"
  trap '_session_sig INT' INT
  trap '_session_sig TERM' TERM
  trap '_session_sig HUP' HUP
  _clip_bridge_start "$(_cbox_clip_dir "p$(basename "$eff")")"
  _container_exec_bridge_start "$(_cbox_container_exec_dir "p$(basename "$eff")")" "$root" || {
    trap - INT TERM HUP
    _clip_bridge_stop
    exec 8>&-
    return 1
  }
  _cbox_compose_up "$eff/.compose.up.stamp" docker compose --project-directory "$eff" -f "$eff/docker-compose.yml" || {
    trap - INT TERM HUP
    _container_exec_bridge_stop
    _clip_bridge_stop
    exec 8>&-
    return 1
  }
  _cbox_netaccess_apply_isolated "$eff" || {
    trap - INT TERM HUP
    _container_exec_bridge_stop
    _clip_bridge_stop
    exec 8>&-
    return 1
  }
  _cbox_ollama_reconcile_networks || echo "cbox: run: ollama per-scope network reconciliation reported an error - run 'cbox ollama reconcile'" >&2
  _cbox_probe_exes_seed "$eff"
  if [ -n "$pre_hook" ]; then
    "$pre_hook" || true
  fi
  _cbox_netaccess_socks_exec_env
  extra_env=("${CBOX_CONTAINER_EXEC_ENV[@]}" "${CBOX_SOCKS_EXEC_ENV[@]}")
  if [ "$use_session_env" = 1 ]; then
    extra_env+=("${CBOX_SESSION_EXEC_ENV[@]}")
  fi
  wd="$(_cbox_realpath "$PWD" 2>/dev/null || printf '%s' "$PWD")"
  case "$wd" in
    "$root"|"$root"/*) ;;
    *) wd="$root" ;;
  esac
  if [ -t 0 ] && [ -t 1 ]; then
    _compose_p "$eff" exec -it "${extra_env[@]}" -w "$wd" cbox /entrypoint.sh "$bin" "$@" || rc=$?
  else
    _compose_p "$eff" exec -T "${extra_env[@]}" -w "$wd" cbox /entrypoint.sh "$bin" "$@" || rc=$?
  fi
  if [ -n "$post_hook" ]; then
    "$post_hook" "$rc" || true
  fi
  exec 8>&-
  trap - INT TERM HUP
  _container_exec_bridge_stop
  _clip_bridge_stop
  _reap "$eff"
  return "$rc"
}

_cbox_rebless_local() {
  local root="$1" eff="$2" rc=0
  mkdir -p "$HOME/.config/cbox/projects"
  exec 7> "$HOME/.config/cbox/projects/.init.lock"
  _cbox_flock -w 60 7 || { echo "cbox: another init is running" >&2; exec 7>&-; return 1; }
  "$INSTALL_DIR/cbox" setup --local "$root" --from-global || rc=$?
  exec 7>&-
  [ "$rc" -eq 0 ] && [ -f "$eff/cbox.conf" ]
}

_cbox_manifest_verify_conf_interactive() {
  local eff="$1" root="$2" status ans reason
  status="$(_cbox_manifest_status "$eff" "$root")"
  case "$status" in
    missing|malformed|drifted)
      if [ -t 0 ] && [ -t 1 ]; then
        case "$status" in
          missing)  reason="manifest missing" ;;
          malformed) reason="manifest malformed" ;;
          drifted)  reason="config/templates drifted" ;;
        esac
        printf 'cbox: effective config for %s: %s.\n  Re-derive from the global profile now? [Y/n] ' "$root" "$reason"
        read -r ans || ans=n
        case "$ans" in
          n|N) : ;;
          *) _cbox_rebless_local "$root" "$eff" || die "re-bless failed for $root" ;;
        esac
      fi
      ;;
  esac
  _cbox_manifest_verify_conf "$eff" "$root"
}

_run_isolated() {
  local bin="$1"; shift
  local root P eff
  root="$(_cbox_workspace_root)" || die "refusing to run in $PWD (home, /, or a mount root)"
  _cbox_check_workspace_overlap "$root"
  P="$(_cbox_path_hash "$root")"
  eff="$HOME/.config/cbox/projects/$P"
  if [ ! -f "$eff/cbox.conf" ]; then
    _first_run_init "$root" "$eff" || return 1
  fi
  _cbox_manifest_verify_conf_interactive "$eff" "$root"
  (
    set -e
    unset CBOX_MODE CBOX_SESSION_SCOPE CBOX_BASE_DIGEST_TTL CBOX_CODEX_TARGET
    local lockfile="$eff/.regen.lock"
    exec 6> "$lockfile"
    _cbox_flock -x 6 || { echo "cbox: cannot lock $lockfile" >&2; exit 1; }
    . "$eff/cbox.conf"
    _cbox_reg_export_vars
    _cbox_load_machine_scoped_vars
    _gen_effective "$eff" "$root"
    local slug
    slug="$(_cbox_slug "$root")"
    mkdir -p "$HOME/.claude/projects/$slug"
    _write_mirror "$root" "$eff"
    _cbox_manifest_write_generated "$eff"
    exec 6>&-
    _ensure_image "$eff"
    _bins_soft "$IMG_TAG"
    _ensure_volumes "$eff"
    _session_run "$eff" "$bin" "$@"
  )
}

_gc_bg() {
  mkdir -p "$HOME/.config/cbox"
  ( _cbox_flock -n 200 || exit 0
    gc
  ) 200> "$HOME/.config/cbox/gc.auto.lock" >/dev/null 2>&1 &
  disown 2>/dev/null || true
}

run() {
  local session_id=""
  if [ "${1:-}" = "--session" ]; then
    session_id="${2:-}"
    [ -n "$session_id" ] || { echo "cbox: usage: $0 run --session <id> <bin> [args...]" >&2; return 1; }
    _cbox_session_id_valid "$session_id" || { echo "cbox: refusing - invalid session id '$session_id'" >&2; return 1; }
    shift 2
  fi
  local bin="${1:-}"
  [ -n "$bin" ] || { echo "cbox: usage: $0 run <bin> [args...]" >&2; return 1; }
  shift
  if [ -n "$session_id" ]; then
    if [ "$(_cbox_effective_mode)" = global ]; then
      echo "cbox: sessions unsupported in global mode v1 - falling back to plain run" >&2
      _run_global "$bin" "$@"
      return
    fi
    _cbox_session_run_leg "$session_id" "$bin" "$@"
    return
  fi
  if [ "$(_cbox_effective_mode)" = global ]; then
    _run_global "$bin" "$@"
    return
  fi
  _run_isolated "$bin" "$@"
}

_project_eff_from_cwd() {
  local root P eff
  root="$(_cbox_workspace_root)" || die "refusing to operate in $PWD (home, /, or a mount root)"
  P="$(_cbox_path_hash "$root")"
  eff="$HOME/.config/cbox/projects/$P"
  [ -f "$eff/cbox.conf" ] || die "no effective config for $root - run 'cbox run codex' or 'cbox setup --local $root' first"
  printf '%s' "$eff"
}

_cbox_down_guard_decision() {
  local locked="$1" probe_n="$2" force="$3"
  if [ "$force" = 1 ]; then
    printf 'proceed'
    return 0
  fi
  if [ "$locked" != 1 ]; then
    printf 'refuse'
    return 0
  fi
  case "$probe_n" in
    ''|*[!0-9]*) printf 'refuse'; return 0 ;;
    0) printf 'proceed'; return 0 ;;
    *) printf 'refuse'; return 0 ;;
  esac
}

down_project() {
  local force="${1:-0}" eff cid locked=0 n decision rc=0
  eff="$(_project_eff_from_cwd)"
  _cbox_manifest_verify_generated "$eff"
  exec 9> "$eff/session.lock"
  if _cbox_flock -n -x 9; then
    locked=1
  fi
  local ps_rc=0
  cid="$(_compose_p "$eff" ps -q cbox 2>/dev/null)" || ps_rc=$?
  n=unknown
  if [ "$ps_rc" -ne 0 ]; then
    n=unknown
  elif [ -n "$cid" ]; then
    n="$(_probe "$cid" "$eff" 2>/dev/null)" || n=unknown
  else
    n=0
  fi
  decision="$(_cbox_down_guard_decision "$locked" "$n" "$force")"
  if [ "$decision" = refuse ]; then
    exec 9>&-
    echo "cbox: refusing down - a session looks live for $eff (probe: $n live process(es)); use 'cbox down --force' to stop anyway" >&2
    return 1
  fi
  if [ "$force" = 1 ] && [ "$locked" != 1 ]; then
    echo "cbox: --force: a session lock is held for $eff; stopping anyway" >&2
  elif [ "$force" = 1 ] && { [ "$n" = unknown ] || [ "$n" != 0 ]; }; then
    echo "cbox: --force: probe reports $n live process(es) for $eff; stopping anyway" >&2
  fi
  _compose_p "$eff" down --remove-orphans || rc=$?
  exec 9>&-
  _cbox_ollama_gc_scope_networks >/dev/null 2>&1 || true
  _cbox_gc_orphan_proxy_networks >/dev/null 2>&1 || true
  return "$rc"
}

shell_isolated() {
  local eff root rc=0
  eff="$(_project_eff_from_cwd)"
  . "$eff/cbox.conf"
  _cbox_load_machine_scoped_vars
  root="$(cat "$eff/workspace" 2>/dev/null)" || return 1
  exec 8> "$eff/session.lock"
  _cbox_flock -s 8 || { echo "cbox: cannot lock session for $eff" >&2; exec 8>&-; return 1; }
  _clip_bridge_start "$(_cbox_clip_dir "p$(basename "$eff")")"
  _container_exec_bridge_start "$(_cbox_container_exec_dir "p$(basename "$eff")")" "$root" || {
    _clip_bridge_stop
    exec 8>&-
    return 1
  }
  _cbox_compose_up "$eff/.compose.up.stamp" docker compose --project-directory "$eff" -f "$eff/docker-compose.yml" || {
    _container_exec_bridge_stop
    _clip_bridge_stop
    exec 8>&-
    return 1
  }
  _cbox_netaccess_apply_isolated "$eff" || {
    _container_exec_bridge_stop
    _clip_bridge_stop
    exec 8>&-
    return 1
  }
  _cbox_ollama_reconcile_networks || echo "cbox: shell: ollama per-scope network reconciliation reported an error - run 'cbox ollama reconcile'" >&2
  _cbox_probe_exes_seed "$eff"
  _cbox_netaccess_socks_exec_env
  if [ -t 0 ] && [ -t 1 ]; then
    _compose_p "$eff" exec -it "${CBOX_CONTAINER_EXEC_ENV[@]}" "${CBOX_SOCKS_EXEC_ENV[@]}" cbox /entrypoint.sh bash || rc=$?
  else
    _compose_p "$eff" exec -T "${CBOX_CONTAINER_EXEC_ENV[@]}" "${CBOX_SOCKS_EXEC_ENV[@]}" cbox /entrypoint.sh bash || rc=$?
  fi
  exec 8>&-
  _container_exec_bridge_stop
  _clip_bridge_stop
  _reap "$eff"
  return "$rc"
}

logs_isolated() {
  local eff
  eff="$(_project_eff_from_cwd)"
  _compose_p "$eff" logs "$@"
}

gc() {
  local cid eff n1 n2
  while IFS="$(printf '\t')" read -r cid eff; do
    [ -n "$cid" ] || continue
    if [ ! -d "$eff" ]; then
      docker stop "$cid" >/dev/null 2>&1 || true
      continue
    fi
    exec 9> "$eff/session.lock"
    if ! _cbox_flock -n -x 9; then
      exec 9>&-
      continue
    fi
    n1="$(_probe "$cid" "$eff" 2>/dev/null)" || n1=unknown
    if [ "$n1" = 0 ]; then
      exec 9>&-
      sleep 10
      exec 9> "$eff/session.lock"
      if _cbox_flock -n -x 9; then
        n2="$(_probe "$cid" "$eff" 2>/dev/null)" || n2=unknown
        if [ "$n2" = 0 ]; then
          _compose_p "$eff" down --remove-orphans >/dev/null 2>&1 || docker stop "$cid" >/dev/null 2>&1 || true
        fi
      fi
    fi
    exec 9>&-
  done < <(docker ps --filter label=cbox.kind=isolated --format '{{.ID}}'$'\t''{{.Label "cbox.effdir"}}')
  local _cbox_gc_exited_ids
  _cbox_gc_exited_ids="$(docker ps -a --filter label=cbox.kind=isolated --filter status=exited -q)"
  if [ -n "$_cbox_gc_exited_ids" ]; then
    printf '%s\n' "$_cbox_gc_exited_ids" | xargs docker rm >/dev/null 2>&1 || true
  fi
  _cbox_ollama_gc_scope_networks
  _cbox_gc_orphan_proxy_networks
  _gc_legacy_bins_volumes
}

net_refresh() {
  local cid img n=0
  while IFS="$(printf '\t')" read -r cid img; do
    [ -n "$cid" ] || continue
    case "$img" in
      cbox-proxy:*|cbox-proxy-img:*)
        docker restart "$cid" >/dev/null 2>&1 && n=$((n+1))
        ;;
    esac
  done < <(docker ps --filter label=com.docker.compose.service=proxy --format '{{.ID}}'$'\t''{{.Image}}')
  echo "cbox: net-refresh: restarted $n proxy container(s); main containers keep their DNS until restart (use CBOX_DNS_MODE=public|stub to make them immune)"
}

_gc_legacy_bins_volumes() {
  local v
  if ! docker volume ls >/dev/null 2>&1; then
    echo "cbox: gc: docker daemon unreachable - skipped legacy volume cleanup" >&2
    return 0
  fi
  docker volume ls --format '{{.Name}}' 2>/dev/null | while IFS= read -r v; do
    case "$v" in
      cbox-i[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]-local|cbox-i[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]-codex-packages)
        if docker volume rm "$v" >/dev/null 2>&1; then
          echo "cbox: gc: removed legacy volume $v"
        fi
        ;;
    esac
  done
  if [ "$HAVE_GLOBAL_CONF" = 1 ]; then
    for v in "${CBOX_NAME:-cbox}-claude-local" "${CBOX_NAME:-cbox}-codex-packages"; do
      if docker volume rm "$v" >/dev/null 2>&1; then
        echo "cbox: gc: removed legacy volume $v"
      fi
    done
  fi
}

ls_projects() {
  printf '%-14s %-14s %s\n' PHASH IMGHASH ROOT
  docker ps --filter label=cbox.kind=isolated --format '{{.Label "cbox.phash"}}'$'\t''{{.Label "cbox.imghash"}}'$'\t''{{.Label "cbox.root"}}' \
  | while IFS="$(printf '\t')" read -r p i r; do
      printf '%-14s %-14s %s\n' "${p:0:12}" "${i:0:12}" "$r"
    done
}

images_list() {
  printf '%-24s %-10s %s\n' TAG SIZE PROJECTS
  local line tag size hash refs proj
  docker images --filter reference='cbox-img:*' --format '{{.Repository}}:{{.Tag}}'$'\t''{{.Size}}' \
  | while IFS="$(printf '\t')" read -r tag size; do
      hash="${tag#cbox-img:}"
      refs=""
      for proj in "$HOME"/.config/cbox/projects/*/; do
        [ -f "$proj/image.inputs" ] || continue
        if grep -q "^base=" "$proj/image.inputs" 2>/dev/null; then
          local ih
          ih="$(_cbox_sha256 "$proj/image.inputs")"
          case "$ih" in "$hash"*) refs="$refs $(basename "$proj")" ;; esac
        fi
      done
      if [ -f "$INSTALL_DIR/image.inputs" ]; then
        local gih
        gih="$(_cbox_sha256 "$INSTALL_DIR/image.inputs")"
        case "$gih" in "$hash"*) refs="$refs global" ;; esac
      fi
      printf '%-24s %-10s %s\n' "$tag" "$size" "${refs# }"
    done
}

images_rm() {
  local hash="${1:-}" tag running refs proj ih
  [ -n "$hash" ] || die "usage: $0 images rm <hash>"
  tag="cbox-img:${hash:0:12}"
  running="$(docker ps -q --filter ancestor="$tag" 2>/dev/null)" || running=""
  [ -z "$running" ] || die "refusing: $tag is in use by a running container"
  refs=""
  for proj in "$HOME"/.config/cbox/projects/*/; do
    [ -f "$proj/image.inputs" ] || continue
    ih="$(_cbox_sha256 "$proj/image.inputs")"
    case "$ih" in "$hash"*) refs="$refs $(basename "$proj")" ;; esac
  done
  if [ -f "$INSTALL_DIR/image.inputs" ]; then
    ih="$(_cbox_sha256 "$INSTALL_DIR/image.inputs")"
    case "$ih" in "$hash"*) refs="$refs global" ;; esac
  fi
  [ -z "$refs" ] || die "refusing: $tag is referenced by project(s):$refs"
  docker rmi "$tag"
}

images_cmd() {
  case "${1:-}" in
    rm) shift; images_rm "${1:-}" ;;
    ""|list) images_list ;;
    *) echo "cbox: usage: $0 images [list|rm <hash>]" >&2; return 1 ;;
  esac
}

_global_prepare() {
  local digest
  gen_managed_settings
