  clip_sock="${CBOX_CLIP_SOCK:-/run/cbox-clip/clip.sock}"
  clip_wired=0
  { [ -n "${CBOX_CLIP_SOCK:-}" ] || [ -d "$(dirname "$clip_sock")" ] || [ "$clip_mode" = bridge ]; } && clip_wired=1
  if [ "$in_container" != 1 ]; then
    _cbox_doctor_row "clipboard" HOST-CHECK "the bridge socket and the wl-paste shim only exist inside a container - run cbox doctor there"
  elif [ "$clip_wired" = 0 ]; then
    _cbox_doctor_row "clipboard" OFF "no bridge socket dir and CBOX_CLIPBOARD_MODE=${clip_mode:-unset}"
  elif [ ! -S "$clip_sock" ]; then
    _cbox_doctor_row "clipboard" CONFIG-ONLY "bridge wired but no socket at $clip_sock - host helper not running, or the host has no clipboard backend"
  elif [ -x /usr/local/bin/wl-paste ]; then
    _cbox_doctor_row "clipboard" ACTIVE "bridge socket $clip_sock, wl-paste shim present"
  else
    _cbox_doctor_row "clipboard" CONFIG-ONLY "bridge socket $clip_sock but no wl-paste shim - image paste cannot reach it"
  fi

  local mi stale_n stale_first
  mi="${CBOX_MOUNTINFO:-/proc/self/mountinfo}"
  if [ "$in_container" != 1 ]; then
    _cbox_doctor_row "stale-binds" HOST-CHECK "only meaningful inside a container - run cbox doctor there"
  elif [ ! -r "$mi" ]; then
    _cbox_doctor_row "stale-binds" MISSING "$mi not readable - cannot tell whether binds went stale"
  else
    local stale_scan
    stale_scan="$(awk '$4 ~ /\/\/deleted$/ {n++; if (n == 1) first = $5} END {print n+0; print first}' "$mi" 2>/dev/null || printf '0\n')"
    stale_n="$(printf '%s\n' "$stale_scan" | sed -n '1p')"
    stale_first="$(printf '%s\n' "$stale_scan" | sed -n '2p')"
    if [ "${stale_n:-0}" -gt 0 ]; then
      _cbox_doctor_row "stale-binds" WARN "$stale_n bind(s) pinned to replaced inodes, e.g. $stale_first - container reads old content, recreate it (restart and rebuild do not clear this)"
    else
      _cbox_doctor_row "stale-binds" ACTIVE "no stale binds - every bind still points at its live source"
    fi
  fi

  echo
  echo "legend: ACTIVE=wired and operational here, CONFIG-ONLY=configured but not active in this container, OFF=disabled, MISSING=expected artifact absent, HOST-CHECK=needs docker/GPU/TTY, not decidable in-container"
}

_cbox_config_load_sections() {
  [ -n "${SECTIONS[*]:-}" ] && return 0
  local sec="$INSTALL_DIR/templates/sections.sh"
  [ -f "$sec" ] || die "$sec missing"
  . "$sec"
}

_cbox_config_load_conf_lib() {
  declare -f _cbox_reg_conf_write_whitelist >/dev/null 2>&1 && return 0
  local lib="$INSTALL_DIR/templates/conf_lib.sh"
  [ -f "$lib" ] || die "$lib missing"
  . "$lib"
}

_cbox_config_in_container() {
  _cbox_doctor_in_container
}

_cbox_config_whitelist() {
  _cbox_config_load_sections
  local s v
  for s in "${SECTIONS[@]}"; do
    for v in $(sec_get SEC_VARS "$s"); do
      printf '%s\n' "$v"
    done
  done
}

_cbox_config_is_whitelisted() {
  local key="$1"
  case "$key" in
    ''|*[!A-Z0-9_]*) return 1 ;;
  esac
  case "$key" in
    [A-Z]*) ;;
    *) return 1 ;;
  esac
  local w
  while IFS= read -r w; do
    [ "$w" = "$key" ] && return 0
  done < <(_cbox_config_whitelist)
  return 1
}

_cbox_config_section_for_var() {
  _cbox_config_load_sections
  local key="$1" s v
  for s in "${SECTIONS[@]}"; do
    for v in $(sec_get SEC_VARS "$s"); do
      [ "$v" = "$key" ] && { printf '%s' "$s"; return 0; }
    done
  done
  return 1
}

_cbox_config_load_validators() {
  declare -f _cbox_val_no_ctrl >/dev/null 2>&1 || . "$INSTALL_DIR/templates/validator_lib.sh"
  declare -f _cbox_reg_validate_var >/dev/null 2>&1 || . "$INSTALL_DIR/templates/validator_dispatch.sh"
}

_cbox_config_validate_var() {
  _cbox_config_load_validators
  _cbox_reg_validate_var "$1" "$2"
}

_cbox_config_dep_gate() {
  local key="$1" section
  _cbox_config_load_sections
  section="$(_cbox_config_section_for_var "$key")" || return 0
  local tok mech cond met=1
  for tok in $(sec_get SEC_DEPS "$section"); do
    mech="${tok%%:*}"
    cond="${tok#*:}"
    met=1
    case "$cond" in
      isolated-mode) [ "${CBOX_MODE:-global}" = isolated ] && met=0 ;;
      no-cdi) command -v nvidia-ctk >/dev/null 2>&1 && [ -f /etc/cdi/nvidia.yaml ] && met=0 ;;
      hermes-off) [ "${CBOX_HERMES:-off}" != on ] && met=0 ;;
      hooks|continuity-hooks) met=0 ;;
    esac
    if [ "$mech" = disable ] && [ "$met" = 0 ]; then
      local _t="$(sec_get SEC_DEP_TEXT "$tok")"
      printf '%s' "${_t:-$tok}"
      return 1
    fi
  done
  return 0
}

_cbox_config_apply_cmd_for() {
  local class="$1"
  case "$class" in
    none) printf 'none - takes effect on next cbox run' ;;
    shell) printf 'source ~/.bashrc' ;;
    restart) printf 'cbox down && cbox run <bin>' ;;
    recreate|topology) printf 'cbox down && cbox run <bin> (compose recreates)' ;;
    rebuild) printf 'next cbox run rebuilds the image automatically (image.inputs changed)' ;;
    infra-reconcile) printf 'cbox ollama reconcile (owner project, not the current cbox compose project)' ;;
    *) printf 'unknown apply class' ;;
  esac
}

_cbox_config_get_conf_for_var() {
  local key="$1" conf="$2" section
  section="$(_cbox_config_section_for_var "$key")" || { printf '%s' "$conf"; return 0; }
  if [ "$(sec_get SEC_SCOPE "$section")" = machine ]; then
    printf '%s' "$INSTALL_DIR/cbox.conf"
  else
    printf '%s' "$conf"
  fi
}

_cbox_config_get() {
  local mode eff conf
  mode="$(_cbox_effective_mode)"
  case "$mode" in
    isolated)
      local root
      root="$(_cbox_workspace_root)" || die "refusing to operate in $PWD (home, /, or a mount root)"
      eff="$HOME/.config/cbox/projects/$(_cbox_path_hash "$root")"
      conf="$eff/cbox.conf"
      ;;
    global)
      conf="$INSTALL_DIR/cbox.conf"
      ;;
    *)
      die_no_conf
      ;;
  esac
  [ -f "$conf" ] || { echo "cbox: no configuration at $conf yet - run 'cbox setup' first" >&2; return 1; }

  _cbox_config_load_sections
  local arg="${1:-}"
  if [ "$arg" = "--all" ]; then
    local s v val vconf
    for s in "${SECTIONS[@]}"; do
      [ -n "$(sec_get SEC_VARS "$s")" ] || continue
      printf '# %s\n' "$s"
      for v in $(sec_get SEC_VARS "$s"); do
        vconf="$(_cbox_config_get_conf_for_var "$v" "$conf")"
        [ -f "$vconf" ] || vconf="$conf"
        val="$(unset "$v"; . "$vconf" >/dev/null 2>&1; printf '%s' "${!v-}")"
        printf '%s=%s\n' "$v" "$val"
      done
    done
    return 0
  fi
  if [ "$arg" = "--section" ]; then
    local sname="${2:-}" v val found=0 vconf
    for s in "${SECTIONS[@]}"; do
      [ "$s" = "$sname" ] && { found=1; break; }
    done
    if [ "$found" != 1 ]; then
      echo "cbox: unknown section '$sname' - valid sections: ${SECTIONS[*]}" >&2
      return 1
    fi
    for v in $(sec_get SEC_VARS "$sname"); do
      vconf="$(_cbox_config_get_conf_for_var "$v" "$conf")"
      [ -f "$vconf" ] || vconf="$conf"
      val="$(unset "$v"; . "$vconf" >/dev/null 2>&1; printf '%s' "${!v-}")"
      printf '%s=%s\n' "$v" "$val"
    done
    return 0
  fi
  local key="$arg"
  if ! _cbox_config_is_whitelisted "$key"; then
    echo "cbox: unknown key '$key' - valid sections: ${SECTIONS[*]}" >&2
    return 1
  fi
  local val vconf
  vconf="$(_cbox_config_get_conf_for_var "$key" "$conf")"
  [ -f "$vconf" ] || vconf="$conf"
  val="$(unset "$key"; . "$vconf" >/dev/null 2>&1; printf '%s' "${!key-}")"
  printf '%s=%s\n' "$key" "$val"
}

_cbox_config_parse_pairs() {
  local pair key val
  CBOX_CONFIG_KEYS=()
  CBOX_CONFIG_VALS=()
  for pair in "$@"; do
    case "$pair" in
      *=*) key="${pair%%=*}"; val="${pair#*=}" ;;
      *) echo "cbox: invalid assignment (expected KEY=VALUE): $pair" >&2; return 1 ;;
    esac
    if ! printf '%s' "$key" | grep -Eq '^[A-Z][A-Z0-9_]*$'; then
      echo "cbox: invalid key '$key' - must match ^[A-Z][A-Z0-9_]*\$" >&2
      return 1
    fi
    if ! _cbox_config_is_whitelisted "$key"; then
      echo "cbox: key '$key' is not in the settable whitelist" >&2
      return 1
    fi
    case "$val" in
      *$'\n'*|*$'\r'*)
        echo "cbox: value for $key contains a newline or carriage return - rejected" >&2
        return 1
        ;;
    esac
    if printf '%s' "$val" | LC_ALL=C grep -qP '\x00'; then
      echo "cbox: value for $key contains a NUL byte - rejected" >&2
      return 1
    fi
    CBOX_CONFIG_KEYS+=("$key")
    CBOX_CONFIG_VALS+=("$val")
  done
  return 0
}

_cbox_config_set_var() {
  local key="$1" val="$2"
  printf -v "$key" '%s' "$val"
}

_cbox_config_touched_sections() {
  local _keys_name="$1"
  local k s out="" seen="" _keys_count _keys_i
  eval "_keys_count=\${#${_keys_name}[@]}"
  _keys_i=0
  while [ "$_keys_i" -lt "$_keys_count" ]; do
    eval "k=\${${_keys_name}[\$_keys_i]}"
    _keys_i=$((_keys_i + 1))
    s="$(_cbox_config_section_for_var "$k")" || continue
    case " $seen " in
      *" $s "*) continue ;;
    esac
    seen="$seen $s"
    out="$out $s"
  done
  printf '%s' "${out# }"
}

_cbox_config_write_pending() {
  local eff="$1"; shift
  local -a sections=("$@")
  local s tmp
  tmp="$(mktemp "$eff/.cbox.XXXXXX")"
  for s in "${sections[@]}"; do
    local _a="$(sec_get SEC_APPLY "$s")"
    printf '%s=%s\n' "$s" "${_a:-none}" >> "$tmp"
  done
  chmod 0644 "$tmp"
  mv "$tmp" "$eff/pending.apply"
}

_cbox_config_section_has_dictate() {
  local s="$1" tok
  for tok in $(sec_get SEC_DEPS "$s"); do
    case "$tok" in dictate:*) return 0 ;; esac
  done
  return 1
}

_cbox_config_print_report() {
  local -a sections=("$@")
  local s
  echo "cbox: config set staged - apply status:"
  for s in "${sections[@]}"; do
    local _a="$(sec_get SEC_APPLY "$s")"
    printf '  %-16s %-10s %s\n' "$s" "${_a:-none}" "$(_cbox_config_apply_cmd_for "${_a:-none}")"
    if _cbox_config_section_has_dictate "$s"; then
      printf '    note: %s has wizard-only auto-deploy behavior (hook install/removal) that headless config set does not perform - run cbox setup to match wizard state if this section flipped on/off\n' "$s"
    fi
  done
}

_cbox_config_regen_isolated() {
  local eff="$1" root="$2"
  _gen_effective "$eff" "$root"
}

_cbox_config_regen_global() {
  _global_prepare
}

_cbox_config_set() {
  if _cbox_config_in_container; then
    echo "cbox: config set is host-only - run it from a host shell, not inside the container (get is still allowed)" >&2
    return 1
  fi
  [ "$#" -ge 1 ] || { echo "cbox: usage: $0 config set KEY=VALUE [KEY=VALUE...]" >&2; return 1; }

  _cbox_config_load_sections
  _cbox_config_load_conf_lib
  _cbox_config_parse_pairs "$@" || return 1

  local i key val errmsg
  for i in "${!CBOX_CONFIG_KEYS[@]}"; do
    key="${CBOX_CONFIG_KEYS[$i]}"
    val="${CBOX_CONFIG_VALS[$i]}"
    if ! errmsg="$(_cbox_config_validate_var "$key" "$val")"; then
      echo "cbox: invalid value for $key: '$val' - ${errmsg:-rejected}" >&2
      return 1
    fi
  done

  local mode
  mode="$(_cbox_effective_mode)"
  if [ "$mode" = isolated ]; then
    local i key section
    for i in "${!CBOX_CONFIG_KEYS[@]}"; do
      key="${CBOX_CONFIG_KEYS[$i]}"
      section="$(_cbox_config_section_for_var "$key")" || continue
      if [ "$(sec_get SEC_SCOPE "$section")" = machine ]; then
        echo "cbox: $key is machine-scoped (section '$section') - set it from the global scope, not an isolated project: cd \$HOME && $0 config set $key=${CBOX_CONFIG_VALS[$i]}" >&2
        return 1
      fi
    done
  fi
  case "$mode" in
    isolated) _cbox_config_set_isolated ;;
    global) _cbox_config_set_global ;;
    *) die_no_conf ;;
  esac
}

_cbox_config_apply_staged_vars() {
  local i
  for i in "${!CBOX_CONFIG_KEYS[@]}"; do
    _cbox_config_set_var "${CBOX_CONFIG_KEYS[$i]}" "${CBOX_CONFIG_VALS[$i]}"
  done
}

_cbox_config_dep_gate_check() {
  local i key reason
  for i in "${!CBOX_CONFIG_KEYS[@]}"; do
    key="${CBOX_CONFIG_KEYS[$i]}"
    if ! reason="$(_cbox_config_dep_gate "$key")"; then
      echo "cbox: rejecting set - dependency rule for $key would force it back: $reason" >&2
      return 1
    fi
  done
  return 0
}

_cbox_config_preserve_extra_lines() {
  local conf="$1" key
  [ -f "$conf" ] || return 0
  while IFS= read -r line; do
    case "$line" in
      [A-Z]*=*)
        key="${line%%=*}"
        if ! _cbox_config_is_whitelisted "$key"; then
          printf '%s\n' "$line"
        fi
        ;;
    esac
  done < "$conf"
}

_cbox_config_set_isolated() {
  local root eff
  root="$(_cbox_workspace_root)" || die "refusing to operate in $PWD (home, /, or a mount root)"
  eff="$HOME/.config/cbox/projects/$(_cbox_path_hash "$root")"
  [ -f "$eff/cbox.conf" ] || die "no effective config for $root - run 'cbox run codex' or 'cbox setup --local $root' first"

  local status
  status="$(_cbox_manifest_status "$eff" "$root")"
  case "$status" in
    malformed|collision)
      echo "cbox: refusing - effective config manifest is $status; re-derive with cbox setup --local --from-global $root" >&2
      return 1
      ;;
    drifted)
      echo "cbox: refusing - effective config has drifted; re-derive with cbox setup --local --from-global $root" >&2
      return 1
      ;;
  esac

  mkdir -p "$eff"
  local lockfile="$eff/.regen.lock"
  exec 6> "$lockfile"
  _cbox_flock -x 6 || { echo "cbox: cannot lock $lockfile" >&2; exec 6>&-; return 1; }

  local backup_conf backup_gen rc=0
  backup_conf="$(mktemp)"
  backup_gen="$(mktemp -d)"
  cp "$eff/cbox.conf" "$backup_conf"
  if [ -d "$eff/generated" ]; then
    cp -a "$eff/generated" "$backup_gen/generated"
  fi

  (
    set -e
    unset CBOX_MODE CBOX_SESSION_SCOPE CBOX_BASE_DIGEST_TTL CBOX_CODEX_TARGET
    . "$eff/cbox.conf"
    _cbox_config_apply_staged_vars
    _cbox_config_dep_gate_check
    _cbox_reg_conf_write_whitelist "$eff/cbox.conf" 1 "$eff/cbox.conf"
    . "$eff/cbox.conf"
    _cbox_reg_export_vars
    _cbox_load_machine_scoped_vars
    _cbox_config_regen_isolated "$eff" "$root"
  ) || rc=$?

  if [ "$rc" -ne 0 ]; then
    local restore_tmp
    restore_tmp="$(mktemp "$eff/.cbox.XXXXXX")"
    cp "$backup_conf" "$restore_tmp"
    chmod 0644 "$restore_tmp"
    mv "$restore_tmp" "$eff/cbox.conf"
    if [ -d "$backup_gen/generated" ]; then
      local restore_gen_tmp
      restore_gen_tmp="$(mktemp -d "$eff/.cbox-gen.XXXXXX")"
      cp -a "$backup_gen/generated/." "$restore_gen_tmp/"
      rm -rf "$eff/generated.stale.$$"
      [ -d "$eff/generated" ] && mv "$eff/generated" "$eff/generated.stale.$$"
      mv "$restore_gen_tmp" "$eff/generated"
      rm -rf "$eff/generated.stale.$$"
    fi
    rm -f "$backup_conf"
    rm -rf "$backup_gen"
    exec 6>&-
    echo "cbox: config set failed - previous configuration and generated artifacts restored" >&2
    return 1
  fi

  rm -f "$backup_conf"
  rm -rf "$backup_gen"

  _cbox_manifest_write "$eff" "$root" "$eff/cbox.conf"
  _cbox_manifest_write_generated "$eff"

  local touched
  touched="$(_cbox_config_touched_sections CBOX_CONFIG_KEYS)"
  local -a touched_arr=()
  read -r -a touched_arr <<< "$touched"
  if [ "${#touched_arr[@]}" -gt 0 ]; then
    _cbox_config_write_pending "$eff" "${touched_arr[@]}"
    _cbox_config_print_report "${touched_arr[@]}"
  fi

  exec 6>&-
  return 0
}

_cbox_config_set_global() {
  require_global_conf
  local conf="$INSTALL_DIR/cbox.conf"
  local lockfile="$INSTALL_DIR/.regen.lock"
  exec 6> "$lockfile"
  _cbox_flock -x 6 || { echo "cbox: cannot lock $lockfile" >&2; exec 6>&-; return 1; }

  local loaded_sha cur_sha
  loaded_sha="$(_cbox_sha256 "$conf")"

  local backup="$conf.bak"
  cp "$conf" "$backup"

  local rc=0
  (
    set -e
    . "$conf"
    _cbox_config_apply_staged_vars
    _cbox_config_dep_gate_check
    cur_sha="$(_cbox_sha256 "$conf")"
    if [ "$cur_sha" != "$loaded_sha" ]; then
      echo "cbox: refusing - global cbox.conf changed on disk since load (concurrent writer race) - re-run config set" >&2
      exit 1
    fi
    local tmp
    tmp="$(mktemp "$INSTALL_DIR/.cbox.XXXXXX")"
    _cbox_reg_conf_write_whitelist "$tmp" 0 "$conf"
    cur_sha="$(_cbox_sha256 "$conf")"
    if [ "$cur_sha" != "$loaded_sha" ]; then
      rm -f "$tmp"
      echo "cbox: refusing - global cbox.conf changed on disk since load (concurrent writer race) - re-run config set" >&2
      exit 1
    fi
    chmod 0644 "$tmp"
    mv "$tmp" "$conf"
    . "$conf"
    _cbox_reg_export_vars
    _cbox_config_regen_global
    _cbox_conf_write_manifest "$conf"
  ) || rc=$?

  if [ "$rc" -ne 0 ]; then
    cp "$backup" "$conf"
    exec 6>&-
    echo "cbox: config set failed - previous global cbox.conf restored (kept at $backup)" >&2
    return 1
  fi

  local touched
  touched="$(_cbox_config_touched_sections CBOX_CONFIG_KEYS)"
  local -a touched_arr=()
  read -r -a touched_arr <<< "$touched"
  if [ "${#touched_arr[@]}" -gt 0 ]; then
    _cbox_config_write_pending "$INSTALL_DIR" "${touched_arr[@]}"
    _cbox_config_print_report "${touched_arr[@]}"
  fi

  echo "cbox: previous global cbox.conf kept at $backup"
  exec 6>&-
  return 0
}

_cbox_config_pending_file() {
  local mode root eff
  mode="$(_cbox_effective_mode)"
  case "$mode" in
    isolated)
      root="$(_cbox_workspace_root)" || die "refusing to operate in $PWD (home, /, or a mount root)"
      eff="$HOME/.config/cbox/projects/$(_cbox_path_hash "$root")"
      printf '%s/pending.apply' "$eff"
      ;;
    global)
      printf '%s/pending.apply' "$INSTALL_DIR"
      ;;
    *)
      die_no_conf
      ;;
  esac
}

_cbox_config_pending() {
  local pf
  pf="$(_cbox_config_pending_file)" || return 1
  case "${1:-}" in
    --clear)
      rm -f "$pf"
      echo "cbox: pending apply info cleared"
      return 0
      ;;
  esac
  if [ -f "$pf" ] && [ -s "$pf" ]; then
    cat "$pf"
  else
    echo "none"
  fi
}

config_cmd() {
  local sub="${1:-}"
  case "$sub" in
    get)
      shift
      _cbox_config_get "$@"
      ;;
    set)
      shift
      _cbox_config_set "$@"
      ;;
    pending)
      shift
      _cbox_config_pending "$@"
      ;;
    *)
      echo "cbox: usage: $0 config {get [KEY|--section NAME|--all]|set KEY=VALUE...|pending [--clear]}" >&2
      return 1
      ;;
  esac
}

_hub_engine_names() {
  local reg="$INSTALL_DIR/etc/engines/engines.json"
  local py="$INSTALL_DIR/etc/engines/engines_registry.py"
  local names="" n enabled_var enabled_val
  [ -f "$reg" ] && [ -f "$py" ] || { printf 'claude\ncodex\n'; return 0; }
  names="$(python3 "$py" names "$reg" 2>/dev/null)" || { printf 'claude\ncodex\n'; return 0; }
  for n in $names; do
    enabled_var="$(python3 "$py" get "$reg" "$n" enabled_var 2>/dev/null)" || enabled_var=""
    case "$enabled_var" in
      ""|null) printf '%s\n' "$n" ;;
      *)
        case "$enabled_var" in
          [A-Za-z_]*[A-Za-z0-9_])
            enabled_val="${!enabled_var:-off}"
            [ "$enabled_val" = on ] && printf '%s\n' "$n"
            ;;
        esac
        ;;
    esac
  done
}

_hub_engine_probe_argv1() {
  local reg="$INSTALL_DIR/etc/engines/engines.json"
  local py="$INSTALL_DIR/etc/engines/engines_registry.py"
  local name="$1" kind
  kind="$(python3 "$py" get "$reg" "$name" probe.kind 2>/dev/null)" || kind=""
  case "$kind" in
    canonical-paths)
      python3 "$py" get "$reg" "$name" probe.argv1 2>/dev/null \
        | python3 -c 'import json,sys; print(json.load(sys.stdin)[0])' 2>/dev/null
      ;;
    *) printf '%s' "$name" ;;
  esac
}

_hub_running_marker() {
  local cid="$1" name="$2" argv1 out
  [ -n "$cid" ] || { printf 'unknown'; return 0; }
  argv1="$(_hub_engine_probe_argv1 "$name")" || argv1="$name"
  [ -n "$argv1" ] || argv1="$name"
  out="$(docker exec "$cid" sh -c '
for p in /proc/[0-9]*/cmdline; do
  [ -e "$p" ] || continue
  a0="$(tr "\0" "\n" < "$p" 2>/dev/null | sed -n 1p)"
  a1="$(tr "\0" "\n" < "$p" 2>/dev/null | sed -n 2p)"
  case "$a0" in
    */entrypoint.sh)
      if [ "$a1" = "$1" ]; then
        d="${p%/cmdline}"
        printf "%s\n" "$d"
        exit 0
      fi
      ;;
    "$1")
      d="${p%/cmdline}"
      printf "%s\n" "$d"
      exit 0
      ;;
  esac
done
exit 1
' sh "$argv1" 2>/dev/null)" || { printf 'unknown'; return 0; }
  [ -n "$out" ] || { printf 'unknown'; return 0; }
  printf 'running'
}

_hub_container_state() {
  local mode="$1" eff="$2" cid state
  if [ "$mode" = global ]; then
    cid="$("${COMPOSE[@]}" ps -q "$SERVICE" 2>/dev/null)" || { printf 'unknown'; return 0; }
  else
    cid="$(_compose_p "$eff" ps -q cbox 2>/dev/null)" || { printf 'unknown'; return 0; }
  fi
  if [ -z "$cid" ]; then
    printf 'down'
    return 0
  fi
  state="$(docker inspect -f '{{.State.StartedAt}}' "$cid" 2>/dev/null)" || { printf 'up (unknown start time)'; return 0; }
  printf 'up (since %s)' "${state:0:19}"
}

_hub_image_freshness() {
  local eff_or_install="$1" want="$2"
  local have=""
  have="$(_cbox_image_hash "$eff_or_install" 2>/dev/null)" || { printf 'unknown'; return 0; }
  if [ "$have" = "$want" ]; then
    printf '%s (fresh)' "${have:0:12}"
  else
    printf '%s (stale)' "${have:0:12}"
  fi
}

_hub_status_line() {
  local mode="$1" eff="$2" cid running_hash state img egress
  state="$(_hub_container_state "$mode" "$eff" 2>/dev/null)" || state=unknown
  if [ "$mode" = global ]; then
    cid="$("${COMPOSE[@]}" ps -q "$SERVICE" 2>/dev/null)" || cid=""
  else
    cid="$(_compose_p "$eff" ps -q cbox 2>/dev/null)" || cid=""
  fi
  running_hash=""
  if [ -n "$cid" ]; then
    running_hash="$(docker inspect -f '{{ index .Config.Labels "cbox.inputs" }}' "$cid" 2>/dev/null)" || running_hash=""
  fi
  if [ -n "$running_hash" ]; then
    img="$(_hub_image_freshness "$eff" "$running_hash" 2>/dev/null)" || img=unknown
  elif [ -n "$cid" ]; then
    img="$(docker inspect -f '{{.Image}}' "$cid" 2>/dev/null | cut -c1-19)" || img=unknown
    [ -n "$img" ] || img=unknown
  else
    img=unknown
  fi
  egress="${CBOX_EGRESS_MODE:-off}"
  printf 'container: %-24s  image: %-16s  egress: %s\n' "$state" "$img" "$egress" >&2
}

_hub_engines_line() {
  local mode="$1" eff="$2" cid name argv1 out=""
  if [ "$mode" = global ]; then
    cid="$("${COMPOSE[@]}" ps -q "$SERVICE" 2>/dev/null)" || cid=""
  else
    cid="$(_compose_p "$eff" ps -q cbox 2>/dev/null)" || cid=""
  fi
  while IFS= read -r name; do
    [ -n "$name" ] || continue
    local mark
    mark="$(_hub_running_marker "$cid" "$name" 2>/dev/null)" || mark=unknown
    case "$mark" in
      running) out="$out $name(running)" ;;
      *) out="$out $name" ;;
    esac
  done < <(_hub_engine_names)
  printf 'engines:%s\n' "$out" >&2
}

_hub_row_running() {
  local mode="$1" eff="$2" name="$3" cid
  if [ "$mode" = global ]; then
    cid="$("${COMPOSE[@]}" ps -q "$SERVICE" 2>/dev/null)" || cid=""
  else
    cid="$(_compose_p "$eff" ps -q cbox 2>/dev/null)" || cid=""
  fi
  [ "$(_hub_running_marker "$cid" "$name" 2>/dev/null)" = running ]
}

_hub_render() {
  local mode="$1" eff="$2" root="$3"
  printf 'cbox - %s   mode: %s\n' "$root" "$mode" >&2
  _hub_status_line "$mode" "$eff"
  _hub_engines_line "$mode" "$eff"
  echo >&2

  local -a names=()
  local n
  while IFS= read -r n; do
    [ -n "$n" ] && names+=("$n")
  done < <(_hub_engine_names)

  HUB_ROWS=()
  local i=1 label end_note=""
  [ "$mode" = global ] && end_note=" (ends hub)"
  for n in "${names[@]}"; do
    if _hub_row_running "$mode" "$eff" "$n"; then
      label="attach - running${end_note}"
    else
      label="start${end_note}"
    fi
    printf '  %d) %-10s [%s]\n' "$i" "$n" "$label" >&2
    HUB_ROWS+=("engine:$n")
    i=$((i + 1))
  done
  if [ "$mode" = global ]; then
    printf '  %d) shell (ends hub)\n' "$i" >&2
  else
    printf '  %d) shell\n' "$i" >&2
  fi
  HUB_ROWS+=("shell")
  i=$((i + 1))
  printf '  %d) logs\n' "$i" >&2
  HUB_ROWS+=("logs")
  i=$((i + 1))
  printf '  %d) doctor\n' "$i" >&2
  HUB_ROWS+=("doctor")
  i=$((i + 1))
  printf '  %d) config\n' "$i" >&2
  HUB_ROWS+=("config")
  i=$((i + 1))
  if _cbox_netaccess_active; then
    printf '  %d) netaccess\n' "$i" >&2
    HUB_ROWS+=("netaccess")
    i=$((i + 1))
  fi
  if [ "${CBOX_OLLAMA_MODE:-off}" = on ] && ! _cbox_config_in_container; then
    printf '  %d) ollama\n' "$i" >&2
    HUB_ROWS+=("ollama")
    i=$((i + 1))
  fi
  if [ "${CBOX_WG_MODE:-off}" != off ] && ! _cbox_config_in_container; then
    printf '  %d) wg\n' "$i" >&2
    HUB_ROWS+=("wg")
    i=$((i + 1))
  fi
  if [ "${CBOX_SESSION_BROKER_MODE:-disabled}" != disabled ] && ! _cbox_config_in_container; then
    printf '  %d) session-broker\n' "$i" >&2
    HUB_ROWS+=("session-broker")
    i=$((i + 1))
  fi
  if [ "$mode" != global ]; then
    printf '  %d) sessions\n' "$i" >&2
    HUB_ROWS+=("sessions")
    i=$((i + 1))
  fi
  printf '  %d) down\n' "$i" >&2
  HUB_ROWS+=("down")
  i=$((i + 1))
  printf '  q) quit\n' >&2
  printf '> ' >&2
}

_hub_dispatch_engine() {
  local mode="$1" name="$2" rc=0
  if [ "$mode" = global ]; then
    echo "cbox: attaching $name in global mode - this ends the hub (exec-replace); start a new 'cbox' for the crossroads again" >&2
  fi
  run "$name" || rc=$?
  return "$rc"
}

_hub_dispatch_shell() {
  local mode="$1" rc=0
  case "$mode" in
    global) shell || rc=$? ;;
