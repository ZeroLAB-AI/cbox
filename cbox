_hub_wg_submenu() {
  while true; do
    echo "cbox wg:" >&2
    echo "  1) status" >&2
    echo "  2) up" >&2
    echo "  3) down" >&2
    echo "  4) keygen" >&2
    echo "  5) peer add" >&2
    echo "  6) peer rm" >&2
    echo "  7) peer list" >&2
    echo "  8) peer config" >&2
    echo "  b) back" >&2
    printf '> ' >&2
    local ans name pubkey addr genkey
    IFS= read -r ans || return 0
    case "$ans" in
      1) wg_cmd status 2>&1 | cat 1>&2 || true ;;
      2) wg_cmd up 2>&1 | cat 1>&2 || true ;;
      3) wg_cmd down 2>&1 | cat 1>&2 || true ;;
      4) wg_cmd keygen 2>&1 | cat 1>&2 || true ;;
      5)
        printf 'peer name: ' >&2
        IFS= read -r name || continue
        [ -n "$name" ] || continue
        printf 'peer public key: ' >&2
        IFS= read -r pubkey || continue
        [ -n "$pubkey" ] || continue
        printf 'peer tunnel host address (CIDR /32): ' >&2
        IFS= read -r addr || continue
        [ -n "$addr" ] || continue
        wg_cmd peer add "$name" "$pubkey" "$addr" 2>&1 | cat 1>&2 || true
