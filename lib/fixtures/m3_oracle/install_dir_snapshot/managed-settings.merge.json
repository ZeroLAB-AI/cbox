{
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "mcp__codex-luna",
      "mcp__codex-terra",
      "mcp__codex-terra-light",
      "mcp__codex-sol"
    ],
    "deny": []
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__codex-.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 @HOME@/.claude/hooks/codex_mode_guard.py",
            "timeout": 10,
            "statusMessage": "codex-mode guard"
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "python3 @HOME@/.claude/hooks/agent_label_guard.py",
            "timeout": 10,
            "statusMessage": "agent-label guard"
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 @HOME@/.claude/hooks/code_hygiene_guard.py",
            "timeout": 10,
            "statusMessage": "code-hygiene guard"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 @HOME@/.claude/hooks/commit_guard.py",
            "timeout": 10,
            "statusMessage": "commit guard"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 @HOME@/.claude/hooks/rm_glob_guard.py",
            "timeout": 10,
            "statusMessage": "rm-glob guard"
          }
        ]
      },
      {
        "matcher": "Agent|Workflow",
        "hooks": [
          {
            "type": "command",
            "command": "python3 @HOME@/.claude/hooks/spawn_gate.py",
            "timeout": 15,
            "statusMessage": "spawn gate"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 @HOME@/.claude/hooks/session_pane_map.py",
            "timeout": 10,
            "statusMessage": "session scope map"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 @HOME@/.claude/hooks/session_pane_map.py",
            "timeout": 10,
            "statusMessage": "session scope unmap"
          }
        ]
      }
    ]
  }
}
