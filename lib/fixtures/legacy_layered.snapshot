CBOX_SESSION_SCOPE=isolated
CBOX_BASE_DIGEST_TTL=3600
CBOX_HISTORY=1
CBOX_GIT=1
CBOX_DIARY=1
CBOX_OPEN_QUESTIONS=1
CBOX_CONTEXT_PROFILE=full
CBOX_KERNEL_LANG_OUTPUT=''
CBOX_KERNEL_LANG_REASONING=slovencina\ bez\ diakritiky
CBOX_USER_DIR=@HOME@/.config/cbox/user
CBOX_PROFILE=default
