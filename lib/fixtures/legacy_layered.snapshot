CBOX_SSH_AGENT_DIR=/run/user/0/cbox-ssh
CBOX_BASHRC=1
CBOX_BASHRC_COMMANDS=all
CBOX_MCP_SERVERS=all
CBOX_CODEX_PROGRESS_MODE=shim
CBOX_CODEX_SHIM_TURN_TIMEOUT_SEC=''
