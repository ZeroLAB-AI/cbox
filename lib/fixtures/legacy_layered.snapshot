CBOX_LIMIT_RESUME_PROMPT=pokracuj
CBOX_LIMIT_RESUME_STAGGER=3
CBOX_LIMIT_RESUME_MAX_PER_DAY=10
CBOX_AGENTS=all
CBOX_CODEX_MCP=0
CBOX_CODEX_HOOKS=off
